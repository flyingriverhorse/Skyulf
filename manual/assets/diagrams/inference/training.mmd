flowchart TD
    accTitle: From training to an inference bundle
    accDescr: pandas or Polars training produces fitted FE state, a Python model and schema metadata, saved together in a bundle.
    train["Training data<br/>pandas / Polars"]:::plain
    fitfe["Fit FE: learn rules<br/>and transform training data"]:::work
    features["Prepared model features"]:::plain
    fitmodel["Fit model on these features"]:::work
    state["features.json<br/>Learned FE state"]:::saved
    model["model.pkl<br/>Fitted Python model"]:::saved
    schema["manifest.json<br/>Columns, order, dtypes, versions"]:::saved
    bundle["Save inference bundle<br/>Load and reuse on new data"]:::saved
    train --> fitfe --> features --> fitmodel
    fitfe -.-> state
    fitmodel -.-> model
    train -.-> schema
    features -.-> schema
    state --> bundle
    model --> bundle
    schema --> bundle
    classDef plain fill:#ffffff,stroke:#64748b,color:#172b3a
    classDef work fill:#e9f5ee,stroke:#287447,color:#172b3a
    classDef saved fill:#e8f0fb,stroke:#245997,color:#172b3a
