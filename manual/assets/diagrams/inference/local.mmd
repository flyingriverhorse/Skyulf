flowchart TD
    accTitle: Local inference paths
    accDescr: Raw input receives fitted FE and model prediction. Prepared feature input bypasses FE.
    raw["New raw data<br/>input_stage = raw"]:::plain
    prepared["Already prepared features<br/>input_stage = features"]:::plain
    checkraw["Validate bundle and raw schema"]:::check
    checkfeatures["Validate bundle and feature schema"]:::check
    fe["Apply saved FE<br/>Local pandas / Polars"]:::work
    model["Predict with the saved model<br/>Local Python"]:::work
    output["Prediction result<br/>pandas DataFrame"]:::plain
    raw --> checkraw --> fe --> model
    prepared --> checkfeatures --> model
    model --> output
    classDef plain fill:#ffffff,stroke:#64748b,color:#172b3a
    classDef check fill:#e8f0fb,stroke:#245997,color:#172b3a
    classDef work fill:#e9f5ee,stroke:#287447,color:#172b3a
