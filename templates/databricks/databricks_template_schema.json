{
  "welcome_message": "Create a bounded Skyulf pandas/Polars Bundle. dev is ready for your CLI profile; edit test, syst and prod target settings before using them.",
  "properties": {
    "project_name": {
      "order": 1,
      "type": "string",
      "default": "skyulf_local",
      "description": "Bundle name (letters, digits and underscores)",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "engine": {
      "order": 2,
      "type": "string",
      "default": "pandas",
      "description": "Local fit and prediction engine",
      "enum": ["pandas", "polars"]
    },
    "compute_mode": {
      "order": 3,
      "type": "string",
      "default": "serverless",
      "description": "Job compute mode for this project",
      "enum": ["serverless", "policy_cluster"]
    },
    "catalog": {
      "order": 4,
      "type": "string",
      "default": "workspace",
      "description": "Existing dev Unity Catalog catalog",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "schema": {
      "order": 5,
      "type": "string",
      "default": "default",
      "description": "Existing dev Unity Catalog schema",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "cluster_policy_name": {
      "order": 6,
      "type": "string",
      "default": "REPLACE_WITH_APPROVED_POLICY",
      "description": "Approved job-cluster policy name",
      "skip_prompt_if": {"properties": {"compute_mode": {"const": "serverless"}}}
    },
    "spark_version": {
      "order": 7,
      "type": "string",
      "default": "17.3.x-cpu-ml-scala2.13",
      "description": "Approved Databricks ML Runtime for the job cluster",
      "skip_prompt_if": {"properties": {"compute_mode": {"const": "serverless"}}}
    },
    "node_type_id": {
      "order": 8,
      "type": "string",
      "default": "REPLACE_WITH_NODE_TYPE",
      "description": "Approved job-cluster node type",
      "skip_prompt_if": {"properties": {"compute_mode": {"const": "serverless"}}}
    },
    "cost_tag_key": {
      "order": 9,
      "type": "string",
      "default": "CostCenter",
      "description": "Approved cluster cost tag key",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "skip_prompt_if": {"properties": {"compute_mode": {"const": "serverless"}}}
    },
    "cost_tag_value": {
      "order": 10,
      "type": "string",
      "default": "REPLACE_WITH_COST_TAG",
      "description": "Approved cluster cost tag value",
      "skip_prompt_if": {"properties": {"compute_mode": {"const": "serverless"}}}
    }
  }
}
