{
  "welcome_message": "Create a bounded Skyulf local-engine Databricks Bundle. Choose personal serverless or company policy-backed targets, then edit config/workflow.json for your data.",
  "properties": {
    "project_name": {
      "order": 1,
      "type": "string",
      "default": "skyulf_local",
      "description": "Bundle name (letters, digits and underscores)",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "engine": {
      "order": 2,
      "type": "string",
      "default": "pandas",
      "description": "Local feature and model engine",
      "enum": ["pandas", "polars"]
    },
    "deployment_mode": {
      "order": 3,
      "type": "string",
      "default": "personal",
      "description": "Deployment profile",
      "enum": ["personal", "company"]
    },
    "catalog": {
      "order": 4,
      "type": "string",
      "default": "workspace",
      "description": "Existing Unity Catalog catalog (simple identifier)",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "skip_prompt_if": {"properties": {"deployment_mode": {"const": "company"}}}
    },
    "schema": {
      "order": 5,
      "type": "string",
      "default": "default",
      "description": "Existing Unity Catalog schema (simple identifier)",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "skip_prompt_if": {"properties": {"deployment_mode": {"const": "company"}}}
    },
    "company_host": {
      "order": 6,
      "type": "string",
      "default": "https://example.invalid",
      "description": "Company Databricks workspace host; verify before deployment",
      "pattern": "^https://[^/]+$",
      "skip_prompt_if": {"properties": {"deployment_mode": {"const": "personal"}}}
    },
    "test_catalog": {
      "order": 7,
      "type": "string",
      "default": "dpt_analytics_test",
      "description": "Test Unity Catalog catalog; reference example, verify with the team",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "skip_prompt_if": {"properties": {"deployment_mode": {"const": "personal"}}}
    },
    "syst_catalog": {
      "order": 8,
      "type": "string",
      "default": "dpt_analytics_syst",
      "description": "System-test Unity Catalog catalog; reference example, verify with the team",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "skip_prompt_if": {"properties": {"deployment_mode": {"const": "personal"}}}
    },
    "prod_catalog": {
      "order": 9,
      "type": "string",
      "default": "dpt_analytics_prod",
      "description": "Production Unity Catalog catalog; reference example, verify with the team",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "skip_prompt_if": {"properties": {"deployment_mode": {"const": "personal"}}}
    },
    "input_schema": {
      "order": 10,
      "type": "string",
      "default": "dsp_refined",
      "description": "Existing labeled and scoring input schema",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "skip_prompt_if": {"properties": {"deployment_mode": {"const": "personal"}}}
    },
    "metadata_schema": {
      "order": 11,
      "type": "string",
      "default": "dsp_metadata",
      "description": "Registered model and internal admission schema",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "skip_prompt_if": {"properties": {"deployment_mode": {"const": "personal"}}}
    },
    "output_schema": {
      "order": 12,
      "type": "string",
      "default": "dsp_mlresult",
      "description": "One prediction table per model in this schema",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "skip_prompt_if": {"properties": {"deployment_mode": {"const": "personal"}}}
    },
    "cluster_policy_name": {
      "order": 13,
      "type": "string",
      "default": "[32] Job ML - ML-JOB-Training-Inference-S2M",
      "description": "Approved company job-cluster policy name; verify with the team",
      "skip_prompt_if": {"properties": {"deployment_mode": {"const": "personal"}}}
    },
    "paying_reg_no": {
      "order": 14,
      "type": "string",
      "default": "34BG",
      "description": "Approved company PayingRegNo cost tag; verify with the team",
      "skip_prompt_if": {"properties": {"deployment_mode": {"const": "personal"}}}
    }
  }
}
