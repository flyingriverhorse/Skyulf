bundle:
  name: {{.project_name}}

include:
  - resources/*.yml

sync:
  include:
    - dist/*.whl
    - config/workflow.json
    - src/workflow.py

variables:
  catalog:
    description: Unity Catalog catalog for the active target
{{if eq .deployment_mode "personal"}}
    default: {{.catalog}}
{{end}}
  input_schema:
    description: Existing labeled and scoring source tables
{{if eq .deployment_mode "personal"}}
    default: {{.schema}}
{{else}}
    default: {{.input_schema}}
{{end}}
  output_schema:
    description: Prediction Delta table
{{if eq .deployment_mode "personal"}}
    default: {{.schema}}
{{else}}
    default: {{.output_schema}}
{{end}}
  metadata_schema:
    description: Registered model and internal admission tables
{{if eq .deployment_mode "personal"}}
    default: {{.schema}}
{{else}}
    default: {{.metadata_schema}}
{{end}}
  resource_suffix:
    description: Non-production namespace suffix; empty for the initial dev project
    default: ""
{{if eq .deployment_mode "company"}}
  cluster_policy_id:
    description: Approved job-cluster policy resolved in this workspace
    lookup:
      cluster_policy: "{{.cluster_policy_name}}"
  paying_reg_no:
    description: Approved PayingRegNo cost allocation tag
    default: "{{.paying_reg_no}}"
{{end}}

targets:
{{if eq .deployment_mode "personal"}}
  dev:
    default: true
    mode: development
{{else}}
  test:
    default: true
    mode: development
    variables:
      catalog: {{.test_catalog}}
      resource_suffix: _${workspace.current_user.short_name}
    workspace:
      host: {{.company_host}}
      root_path: ~/{{.project_name}}/test
  syst:
    mode: production
    variables:
      catalog: {{.syst_catalog}}
      resource_suffix: ""
    workspace:
      host: {{.company_host}}
      root_path: ~/{{.project_name}}/syst
  prod:
    mode: production
    variables:
      catalog: {{.prod_catalog}}
      resource_suffix: ""
    workspace:
      host: {{.company_host}}
      root_path: ~/{{.project_name}}/prod
{{end}}
