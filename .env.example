# ── Skyulf Demo Deployment ──────────────────────────────────────────────
# Copy this file to .env and fill in the values for your Render deployment.

# Demo mode: locks the app to the Iris dataset, disables all uploads.
DEMO_MODE=true

# ── Security ────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-random-secret

# Comma-separated allowed origins (or JSON array).
CORS_ORIGINS=https://app.skyulf.com
ALLOWED_HOSTS=api.skyulf.com,localhost

# ── Database (Supabase Postgres) ────────────────────────────────────────
# Paste your Supabase connection string:
# postgresql+asyncpg://postgres:PASSWORD@db.XXX.supabase.co:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:change-me@db.example.supabase.co:5432/postgres

# ── Celery / Redis (optional) ───────────────────────────────────────────
USE_CELERY=false

# ── Server ──────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production
