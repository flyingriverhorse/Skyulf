flowchart TD
    accTitle: Available native Spark FE and Python model inference
    accDescr: Spark data stays distributed. Saved FE rules execute as native Spark expressions; prepared feature batches reach the same Python model on workers.
    bundle["Driver: load bundle<br/>Validate support, schema, versions"]:::check
    raw["Distributed Spark input<br/>Raw features + record_key_columns"]:::plain
    fe["Native FE on Spark partitions<br/>Apply saved transformation rules"]:::work
    a["Python worker A<br/>Prepared feature batch<br/>Predict with the same model"]:::work
    b["Python worker B<br/>Prepared feature batch<br/>Predict with the same model"]:::work
    result["Spark DataFrame<br/>record_key_columns + prediction"]:::plain
    raw --> fe
    bundle -.->|"Learned FE state"| fe
    bundle -.->|"Model payload"| a
    bundle -.->|"Model payload"| b
    fe -->|"Features + keys"| a
    fe -->|"Features + keys"| b
    a --> result
    b --> result
    classDef plain fill:#ffffff,stroke:#64748b,color:#172b3a
    classDef check fill:#e8f0fb,stroke:#245997,color:#172b3a
    classDef work fill:#e9f5ee,stroke:#287447,color:#172b3a
