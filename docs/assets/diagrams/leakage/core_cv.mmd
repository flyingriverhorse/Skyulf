flowchart LR
    raw["Raw rows"]:::plain
    fold["KFold<br/>split raw indices"]:::boundary
    dataset["SplitDataset<br/>train = fold train<br/>test = fold validation"]:::plain
    fresh["NEW SkyulfPipeline<br/>fit on fold train<br/>only"]:::safe
    score["Predict raw<br/>fold validation<br/>and record score"]:::safe
    raw --> fold
    fold --> dataset
    dataset --> fresh
    fresh --> score
    score -.->|"Repeat with a new pipeline for the next fold"| fold
    classDef plain fill:#ffffff,stroke:#64748b,color:#172b3a
