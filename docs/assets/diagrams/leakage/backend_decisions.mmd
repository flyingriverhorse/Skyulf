flowchart TB
    request["Run request<br/>selected execution scope"]:::plain
    gate["Full-graph leakage gate<br/>operation-aware checks"]:::boundary
    reject["Detected violation + raise<br/>HTTP 400<br/>No job created"]:::risk
    jobs["Accepted execution<br/>create / dispatch jobs"]:::plain
    resolve["CV / tuning<br/>resolve fold-refit adapter"]:::boundary
    refit["Supported shape<br/>refit preprocessing<br/>inside each fold"]:::safe
    fallback["Unsupported learned path<br/>raise: stop execution<br/>warn/ignore: explicit fallback"]:::risk
    request --> gate
    gate --> reject
    gate -->|"permitted"| jobs
    jobs --> resolve
    resolve --> refit
    resolve -->|"cannot reconstruct"| fallback
    classDef plain fill:#ffffff,stroke:#64748b,color:#172b3a
    classDef boundary fill:#e8f0fb,stroke:#245997,color:#172b3a
    classDef safe fill:#e9f5ee,stroke:#287447,color:#172b3a
    classDef risk fill:#fff0e8,stroke:#aa4b23,color:#172b3a
