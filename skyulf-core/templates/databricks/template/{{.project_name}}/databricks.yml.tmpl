bundle:
  name: {{.project_name}}

include:
  - resources/*.yml

sync:
  include:
    - dist/*.whl
    - config/workflow.json
    - src/workflow.py

variables:
  catalog:
    description: Unity Catalog catalog selected by the active target
    default: {{.catalog}}
  input_schema:
    description: Existing training and scoring source schema
    default: {{.schema}}
  output_schema:
    description: Prediction output schema
    default: {{.schema}}
  metadata_schema:
    description: Registered model schema
    default: {{.schema}}
  resource_suffix:
    description: Optional namespace suffix for shared development targets
    default: ""
{{if eq .retraining_mode "monthly_paused"}}
  retraining_cron_expression:
    description: Editable Quartz cron for the paused training job
    default: "{{.retraining_cron_expression}}"
  retraining_timezone_id:
    description: IANA timezone for the paused training schedule
    default: "{{.retraining_timezone_id}}"
{{end}}
{{if eq .compute_mode "policy_cluster"}}
  cluster_policy_id:
    description: Approved policy looked up in the active workspace
    lookup:
      cluster_policy: "{{.cluster_policy_name}}"
  cost_tag_value:
    description: Approved cluster cost allocation tag value
    default: "{{.cost_tag_value}}"
{{end}}

targets:
  dev:
    default: true
    mode: development
    variables:
      catalog: {{.catalog}}
      input_schema: {{.schema}}
      output_schema: {{.schema}}
      metadata_schema: {{.schema}}
      resource_suffix: ""
  # Replace each placeholder before deploying outside dev. Hosts are distinct
  # on purpose: a personal dev profile cannot become a production default.
  test:
    mode: development
    variables:
      catalog: REPLACE_TEST_CATALOG
      input_schema: REPLACE_TEST_INPUT_SCHEMA
      output_schema: REPLACE_TEST_OUTPUT_SCHEMA
      metadata_schema: REPLACE_TEST_METADATA_SCHEMA
      resource_suffix: _${workspace.current_user.short_name}
    workspace:
      host: https://replace-test.example.invalid
      root_path: ~/{{.project_name}}/test
  syst:
    mode: production
    variables:
      catalog: REPLACE_SYST_CATALOG
      input_schema: REPLACE_SYST_INPUT_SCHEMA
      output_schema: REPLACE_SYST_OUTPUT_SCHEMA
      metadata_schema: REPLACE_SYST_METADATA_SCHEMA
      resource_suffix: ""
    workspace:
      host: https://replace-syst.example.invalid
      root_path: ~/{{.project_name}}/syst
  prod:
    mode: production
    variables:
      catalog: REPLACE_PROD_CATALOG
      input_schema: REPLACE_PROD_INPUT_SCHEMA
      output_schema: REPLACE_PROD_OUTPUT_SCHEMA
      metadata_schema: REPLACE_PROD_METADATA_SCHEMA
      resource_suffix: ""
    workspace:
      host: https://replace-prod.example.invalid
      root_path: ~/{{.project_name}}/prod
