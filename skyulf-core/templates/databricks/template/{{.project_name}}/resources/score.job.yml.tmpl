resources:
  jobs:
    score:
      name: ${bundle.name}_score
      tags: ${var.job_tags}
{{if eq .compute_mode "serverless"}}
      budget_policy_id: ${var.serverless_budget_policy_id}
{{end}}
      timeout_seconds: ${var.score_timeout_seconds}
      health:
        rules: ${var.score_health_rules}
      email_notifications: ${var.score_email_notifications}
      webhook_notifications: ${var.score_webhook_notifications}
      max_concurrent_runs: 1
      queue:
        enabled: true
      parameters:
        - name: score_model_version
          default: ""
{{if eq .scoring_mode "scheduled"}}
      schedule:
        quartz_cron_expression: ${var.scoring_cron_expression}
        timezone_id: ${var.scoring_timezone_id}
        pause_status: ${var.scoring_pause_status}
{{end}}
      tasks:
        - task_key: score
          timeout_seconds: ${var.score_task_timeout_seconds}
          max_retries: ${var.score_max_retries}
          min_retry_interval_millis: ${var.score_min_retry_interval_millis}
          retry_on_timeout: false
          notebook_task:
{{if eq .training_layout "multi_target"}}
            notebook_path: ../src/jobs/score_models.py
{{else}}
            notebook_path: ../src/jobs/score.py
{{end}}
            base_parameters:
              workflow_contract: "3"
              deployed_score_handoff: "{{.score_handoff}}"
              deployed_auto_rebuild_on_cdf_expiry: "{{.auto_rebuild_on_cdf_expiry}}"
              score_model_version: '{{"{{job.parameters.score_model_version}}"}}'
              config_path: ${workspace.file_path}/config/workflow.json
              catalog: ${var.catalog}
              input_schema: ${var.input_schema}
              output_schema: ${var.output_schema}
              metadata_schema: ${var.metadata_schema}
              resource_suffix: ${var.resource_suffix}
              monitoring_enabled: ${var.monitoring_enabled}
              monitoring_drift_thresholds: ${var.monitoring_drift_thresholds}
              monitoring_catalog: ${var.monitoring_catalog}
              monitoring_schema: ${var.monitoring_schema}
              monitoring_label_table: ${var.monitoring_label_table}
              monitoring_result_available_at_column: ${var.monitoring_result_available_at_column}
              monitoring_expected_interval_hours: ${var.monitoring_expected_interval_hours}
              monitoring_environment: ${bundle.target}
              monitoring_deployment_mode: ${bundle.mode}
              monitoring_project: ${bundle.name}
{{if eq .compute_mode "serverless"}}
          environment_key: skyulf
          disable_auto_optimization: true
{{else}}
          job_cluster_key: skyulf
          libraries:
            - whl: ../dist/skyulf/*.whl
            - requirements: ${workspace.file_path}/deployment/requirements.txt
{{end}}
{{if eq .auto_rebuild_on_cdf_expiry "true"}}
        - task_key: recovery_needed
          depends_on:
            - task_key: score
          condition_task:
            op: EQUAL_TO
            left: '{{"{{tasks.score.values.recovery_required}}"}}'
            right: "true"
        - task_key: recover_predictions
          depends_on:
            - task_key: recovery_needed
              outcome: "true"
          timeout_seconds: ${var.score_task_timeout_seconds}
          max_retries: ${var.score_max_retries}
          min_retry_interval_millis: ${var.score_min_retry_interval_millis}
          retry_on_timeout: false
          notebook_task:
            notebook_path: ../src/jobs/recover_predictions.py
            base_parameters:
              workflow_contract: "3"
              deployed_score_handoff: "{{.score_handoff}}"
              deployed_auto_rebuild_on_cdf_expiry: "{{.auto_rebuild_on_cdf_expiry}}"
              config_path: ${workspace.file_path}/config/workflow.json
              catalog: ${var.catalog}
              input_schema: ${var.input_schema}
              output_schema: ${var.output_schema}
              metadata_schema: ${var.metadata_schema}
              resource_suffix: ${var.resource_suffix}
              monitoring_enabled: ${var.monitoring_enabled}
              monitoring_drift_thresholds: ${var.monitoring_drift_thresholds}
              monitoring_catalog: ${var.monitoring_catalog}
              monitoring_schema: ${var.monitoring_schema}
              monitoring_label_table: ${var.monitoring_label_table}
              monitoring_result_available_at_column: ${var.monitoring_result_available_at_column}
              monitoring_expected_interval_hours: ${var.monitoring_expected_interval_hours}
              monitoring_environment: ${bundle.target}
              monitoring_deployment_mode: ${bundle.mode}
              monitoring_project: ${bundle.name}
{{if eq .compute_mode "serverless"}}
          environment_key: skyulf
          disable_auto_optimization: true
{{else}}
          job_cluster_key: skyulf
          libraries:
            - whl: ../dist/skyulf/*.whl
            - requirements: ${workspace.file_path}/deployment/requirements.txt
{{end}}
        - task_key: scoring_report
          depends_on:
            - task_key: recovery_needed
              outcome: "false"
            - task_key: recover_predictions
          run_if: NONE_FAILED
          timeout_seconds: ${var.score_task_timeout_seconds}
          max_retries: ${var.score_max_retries}
          min_retry_interval_millis: ${var.score_min_retry_interval_millis}
          retry_on_timeout: false
          notebook_task:
            notebook_path: ../src/jobs/scoring_report.py
            base_parameters:
              workflow_contract: "3"
              deployed_score_handoff: "{{.score_handoff}}"
              deployed_auto_rebuild_on_cdf_expiry: "{{.auto_rebuild_on_cdf_expiry}}"
              config_path: ${workspace.file_path}/config/workflow.json
              catalog: ${var.catalog}
              input_schema: ${var.input_schema}
              output_schema: ${var.output_schema}
              metadata_schema: ${var.metadata_schema}
              resource_suffix: ${var.resource_suffix}
              monitoring_enabled: ${var.monitoring_enabled}
              monitoring_drift_thresholds: ${var.monitoring_drift_thresholds}
              monitoring_catalog: ${var.monitoring_catalog}
              monitoring_schema: ${var.monitoring_schema}
              monitoring_label_table: ${var.monitoring_label_table}
              monitoring_result_available_at_column: ${var.monitoring_result_available_at_column}
              monitoring_expected_interval_hours: ${var.monitoring_expected_interval_hours}
              monitoring_environment: ${bundle.target}
              monitoring_deployment_mode: ${bundle.mode}
              monitoring_project: ${bundle.name}
{{if eq .compute_mode "serverless"}}
          environment_key: skyulf
          disable_auto_optimization: true
{{else}}
          job_cluster_key: skyulf
          libraries:
            - whl: ../dist/skyulf/*.whl
            - requirements: ${workspace.file_path}/deployment/requirements.txt
{{end}}
{{end}}
        - task_key: monitoring_allowed
          description: Monitor shared deployments only; skip ephemeral development models
          depends_on:
            - task_key: {{if eq .auto_rebuild_on_cdf_expiry "true"}}scoring_report{{else}}score{{end}}
          condition_task:
            op: EQUAL_TO
            left: ${bundle.mode}
            right: production
        - task_key: monitor_model
          description: Calculate drift, data quality and available labeled performance for the saved scoring batch
          depends_on:
            - task_key: monitoring_allowed
              outcome: "true"
          timeout_seconds: ${var.score_task_timeout_seconds}
          max_retries: ${var.score_max_retries}
          min_retry_interval_millis: ${var.score_min_retry_interval_millis}
          retry_on_timeout: false
          notebook_task:
            notebook_path: ../src/jobs/monitor_model.py
            base_parameters:
              workflow_contract: "3"
              deployed_score_handoff: "{{.score_handoff}}"
              deployed_auto_rebuild_on_cdf_expiry: "{{.auto_rebuild_on_cdf_expiry}}"
              score_model_version: '{{"{{job.parameters.score_model_version}}"}}'
              config_path: ${workspace.file_path}/config/workflow.json
              catalog: ${var.catalog}
              input_schema: ${var.input_schema}
              output_schema: ${var.output_schema}
              metadata_schema: ${var.metadata_schema}
              resource_suffix: ${var.resource_suffix}
              monitoring_experiment_name: ${var.monitoring_experiment_name}
              monitoring_dashboard_url: ${var.monitoring_dashboard_url}
              monitoring_enabled: ${var.monitoring_enabled}
              monitoring_drift_thresholds: ${var.monitoring_drift_thresholds}
              monitoring_catalog: ${var.monitoring_catalog}
              monitoring_schema: ${var.monitoring_schema}
              monitoring_label_table: ${var.monitoring_label_table}
              monitoring_result_available_at_column: ${var.monitoring_result_available_at_column}
              monitoring_expected_interval_hours: ${var.monitoring_expected_interval_hours}
              monitoring_environment: ${bundle.target}
              monitoring_deployment_mode: ${bundle.mode}
              monitoring_project: ${bundle.name}
{{if eq .compute_mode "serverless"}}
          environment_key: skyulf
          disable_auto_optimization: true
{{else}}
          job_cluster_key: skyulf
          libraries:
            - whl: ../dist/skyulf/*.whl
            - requirements: ${workspace.file_path}/deployment/requirements.txt
{{end}}
        - task_key: drift_report
          description: Show saved per-feature drift values and limits without recalculating monitoring
          depends_on:
            - task_key: monitor_model
          timeout_seconds: ${var.score_task_timeout_seconds}
          max_retries: ${var.score_max_retries}
          min_retry_interval_millis: ${var.score_min_retry_interval_millis}
          retry_on_timeout: false
          notebook_task:
            notebook_path: ../src/jobs/drift_report.py
            base_parameters:
              workflow_contract: "3"
              monitoring_dashboard_url: ${var.monitoring_dashboard_url}
{{if eq .compute_mode "serverless"}}
          environment_key: skyulf
          disable_auto_optimization: true
{{else}}
          job_cluster_key: skyulf
          libraries:
            - whl: ../dist/skyulf/*.whl
            - requirements: ${workspace.file_path}/deployment/requirements.txt
{{end}}
        - task_key: check_retraining
          description: Optionally request the existing train job after drift and fresh labeled training data
          depends_on:
            - task_key: drift_report
          timeout_seconds: ${var.score_task_timeout_seconds}
          max_retries: ${var.score_max_retries}
          min_retry_interval_millis: ${var.score_min_retry_interval_millis}
          retry_on_timeout: false
          notebook_task:
            notebook_path: ../src/jobs/check_retraining.py
            base_parameters:
              on_drift: ${var.on_drift}
              on_drift_cooldown_hours: ${var.on_drift_cooldown_hours}
              on_drift_min_new_training_rows: ${var.on_drift_min_new_training_rows}
              train_job_name: ${bundle.name}_train
              score_job_name: '{{"{{job.name}}"}}'
              workflow_contract: "3"
              deployed_score_handoff: "{{.score_handoff}}"
              deployed_auto_rebuild_on_cdf_expiry: "{{.auto_rebuild_on_cdf_expiry}}"
              score_model_version: '{{"{{job.parameters.score_model_version}}"}}'
              config_path: ${workspace.file_path}/config/workflow.json
              catalog: ${var.catalog}
              input_schema: ${var.input_schema}
              output_schema: ${var.output_schema}
              metadata_schema: ${var.metadata_schema}
              resource_suffix: ${var.resource_suffix}
              monitoring_experiment_name: ${var.monitoring_experiment_name}
              monitoring_dashboard_url: ${var.monitoring_dashboard_url}
              monitoring_enabled: ${var.monitoring_enabled}
              monitoring_drift_thresholds: ${var.monitoring_drift_thresholds}
              monitoring_catalog: ${var.monitoring_catalog}
              monitoring_schema: ${var.monitoring_schema}
              monitoring_label_table: ${var.monitoring_label_table}
              monitoring_result_available_at_column: ${var.monitoring_result_available_at_column}
              monitoring_expected_interval_hours: ${var.monitoring_expected_interval_hours}
              monitoring_environment: ${bundle.target}
              monitoring_deployment_mode: ${bundle.mode}
              monitoring_project: ${bundle.name}
{{if eq .compute_mode "serverless"}}
          environment_key: skyulf
          disable_auto_optimization: true
{{else}}
          job_cluster_key: skyulf
          libraries:
            - whl: ../dist/skyulf/*.whl
            - requirements: ${workspace.file_path}/deployment/requirements.txt
{{end}}
        - task_key: retraining_needed
          depends_on:
            - task_key: check_retraining
          condition_task:
            op: EQUAL_TO
            left: '{{"{{tasks.check_retraining.values.retraining_needed}}"}}'
            right: "true"
        - task_key: retrain_on_drift
          description: Optionally request the existing train job after drift and fresh labeled training data
          depends_on:
            - task_key: retraining_needed
              outcome: "true"
          timeout_seconds: ${var.score_task_timeout_seconds}
          max_retries: ${var.score_max_retries}
          min_retry_interval_millis: ${var.score_min_retry_interval_millis}
          retry_on_timeout: false
          notebook_task:
            notebook_path: ../src/jobs/retrain_on_drift.py
            base_parameters:
              on_drift: ${var.on_drift}
              on_drift_cooldown_hours: ${var.on_drift_cooldown_hours}
              on_drift_min_new_training_rows: ${var.on_drift_min_new_training_rows}
              train_job_name: ${bundle.name}_train
              score_job_name: '{{"{{job.name}}"}}'
              workflow_contract: "3"
              deployed_score_handoff: "{{.score_handoff}}"
              deployed_auto_rebuild_on_cdf_expiry: "{{.auto_rebuild_on_cdf_expiry}}"
              score_model_version: '{{"{{job.parameters.score_model_version}}"}}'
              config_path: ${workspace.file_path}/config/workflow.json
              catalog: ${var.catalog}
              input_schema: ${var.input_schema}
              output_schema: ${var.output_schema}
              metadata_schema: ${var.metadata_schema}
              resource_suffix: ${var.resource_suffix}
              monitoring_experiment_name: ${var.monitoring_experiment_name}
              monitoring_dashboard_url: ${var.monitoring_dashboard_url}
              monitoring_enabled: ${var.monitoring_enabled}
              monitoring_drift_thresholds: ${var.monitoring_drift_thresholds}
              monitoring_catalog: ${var.monitoring_catalog}
              monitoring_schema: ${var.monitoring_schema}
              monitoring_label_table: ${var.monitoring_label_table}
              monitoring_result_available_at_column: ${var.monitoring_result_available_at_column}
              monitoring_expected_interval_hours: ${var.monitoring_expected_interval_hours}
              monitoring_environment: ${bundle.target}
              monitoring_deployment_mode: ${bundle.mode}
              monitoring_project: ${bundle.name}
{{if eq .compute_mode "serverless"}}
          environment_key: skyulf
          disable_auto_optimization: true
{{else}}
          job_cluster_key: skyulf
          libraries:
            - whl: ../dist/skyulf/*.whl
            - requirements: ${workspace.file_path}/deployment/requirements.txt
{{end}}
        - task_key: retraining_skipped
          description: Show why automatic training was not requested
          depends_on:
            - task_key: retraining_needed
              outcome: "false"
          timeout_seconds: ${var.score_task_timeout_seconds}
          max_retries: ${var.score_max_retries}
          min_retry_interval_millis: ${var.score_min_retry_interval_millis}
          retry_on_timeout: false
          notebook_task:
            notebook_path: ../src/jobs/retraining_skipped.py
            base_parameters:
              workflow_contract: "3"
{{if eq .compute_mode "serverless"}}
          environment_key: skyulf
          disable_auto_optimization: true
{{else}}
          job_cluster_key: skyulf
          libraries:
            - whl: ../dist/skyulf/*.whl
            - requirements: ${workspace.file_path}/deployment/requirements.txt
{{end}}
{{if eq .compute_mode "serverless"}}
      environments:
        - environment_key: skyulf
          spec:
            client: ${var.serverless_environment_version}
            dependencies:
              - ../dist/skyulf/*.whl
              - -r ${workspace.file_path}/deployment/requirements.txt
{{else}}
      job_clusters:
        - job_cluster_key: skyulf
          new_cluster:
            spark_version: ${var.spark_version}
            node_type_id: ${var.node_type_id}
            policy_id: ${var.cluster_policy_id}
            custom_tags:
              {{.cost_tag_key}}: ${var.cost_tag_value}
            autoscale:
              min_workers: ${var.min_workers}
              max_workers: ${var.max_workers}
{{end}}
