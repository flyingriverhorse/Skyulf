resources:
  jobs:
    online_publication:
      name: ${bundle.name}_online_publication
      tags: ${var.job_tags}
      budget_policy_id: ${var.monitoring_budget_policy_id}
      max_concurrent_runs: 1
      queue:
        enabled: true
      timeout_seconds: ${var.monitoring_timeout_seconds}
      parameters:
        - name: publication_action
          default: start
{{if eq .online_publication_mode "TRIGGERED"}}
      schedule:
        quartz_cron_expression: "0 0 * * * ?"
        timezone_id: UTC
        pause_status: PAUSED
{{end}}
      tasks:
        - task_key: online_publication
          description: Explicit native publication start, status, stop or restart for the pinned source
          timeout_seconds: ${var.monitoring_task_timeout_seconds}
          max_retries: 0
          disable_auto_optimization: true
          environment_key: serving
          notebook_task:
            notebook_path: ../src/jobs/online_publication.py
            base_parameters:
              serving_config_path: ${workspace.file_path}/config/serving.yml
              publication_action: "{{`{{job.parameters.publication_action}}`}}"
      environments:
        - environment_key: serving
          spec:
            client: ${var.monitoring_environment_version}
            dependencies:
              - -r ${workspace.file_path}/deployment/serving-requirements.txt
