resources:
  jobs:
    online_serving_setup:
      name: ${bundle.name}_online_serving_setup
      tags: ${var.job_tags}
      budget_policy_id: ${var.monitoring_budget_policy_id}
      max_concurrent_runs: 1
      queue:
        enabled: true
      timeout_seconds: ${var.monitoring_timeout_seconds}
      tasks:
        - task_key: online_serving_setup
          description: Inspect a concrete online feature model and create one new endpoint
          timeout_seconds: ${var.monitoring_task_timeout_seconds}
          max_retries: 0
          disable_auto_optimization: true
          environment_key: serving
          notebook_task:
            notebook_path: ../src/jobs/online_serving_setup.py
            base_parameters:
              serving_config_path: ${workspace.file_path}/config/serving.yml
      environments:
        - environment_key: serving
          spec:
            client: ${var.monitoring_environment_version}
            dependencies:
              - ../dist/skyulf/*.whl
              - -r ${workspace.file_path}/deployment/serving-requirements.txt
