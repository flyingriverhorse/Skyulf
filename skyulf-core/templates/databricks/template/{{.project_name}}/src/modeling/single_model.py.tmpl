"""Editable model and tuning settings for single-model training.

Bundle fills MODELING from your selections. Change model parameters, tuning
strategy or search_space here; the loader binds this to pipeline.modeling.
Keep config/workflow.json's pipeline.modeling empty to avoid two definitions.
An ensemble is one model: its members/settings live in base_model.params.
Set search_space to {} to rebuild automatic ranges from the installed Core.
After changing ensemble members or calibration, update nested search keys or
clear the space. Fixed model parameters must not contradict searched axes.

model_competition.py describes competitors for one target. multi_model.py
describes independent targets; model_set.py governs their joint publication.
Those layouts do not use this file. Scoring replays the saved fitted artifact.
"""

from copy import deepcopy

# To fix class weights for a supported classifier, edit MODELING below:
#   "base_model": {"type": "logistic_regression", "params": {"class_weight": "balanced"}}
# Add the key to the existing params; preserve your model type and other settings.
# Use Python None to disable it. Remove "class_weight" from this model's
# search_space to keep the value fixed. To tune it instead, keep the search axis
# and omit the fixed class_weight key from base_model.params.
# Sample weights are optional and independent of class_weight.
# Set WEIGHT_COLUMN below to a training column, e.g. "training_weight".
# None disables sample weights; scoring never needs this column.
# Both settings can be enabled together. Class weights apply only to classifiers.


WEIGHT_COLUMN = {{if eq .sample_weight_enabled "true"}}"{{.weight_column}}"{{else}}None{{end}}

# Classification only. Off keeps native model decisions.
# Binary manual: {"mode": "manual", "positive_class": 1, "value": 0.7}
# Multiclass manual: {"mode": "manual", "thresholds": [
#     {"class": "a", "value": 0.4}, {"class": "b", "value": 0.3},
#     {"class": "c", "value": 0.3}]}
# Auto: {"mode": "auto", "metric": "balanced_accuracy",
#        "validation_fraction": 0.2, "random_state": 42}
# Use original typed target labels, even when preprocessing encodes the target.
# Auto reserves training rows; it never uses final holdout.
# Do not also enable the legacy modeling.tune_threshold setting.
DECISION_THRESHOLD = {"mode": "off"}

{{ $model := index . (printf "%s_model" .task) }}
{{ if eq .sample_weight_enabled "true" }}{{ $model = index . (printf "%s_model_weighted" .task) }}{{ end }}
MODELING = {{if eq .training_layout "single_model"}}{{template "modeling" (map (pair "values" .) (pair "prefix" "") (pair "model" $model) (pair "task" .task) (pair "ensemble_prefix" "single_ensemble_"))}}{{else}}{}{{end}}


def build_modeling():
    """Return independent settings for the next training run or offline preview."""
    return deepcopy(MODELING)
