"""Independent target declarations generated by Bundle initialization.

Each workflow overlays config/workflow.json. Top-level values are replaced,
including the entire pipeline; nested settings are never implicitly merged.
Select preprocessing_recipe and pre_split_recipe independently from named
builders in src/features. Use features_path for a separate feature package.
Keep every known target column out of every branch's input_columns.
Each branch owns its model, tuning, folds, metric and quality policy.
RMSE/MAE/log-loss thresholds are upper limits; accuracy/F1/AUC/R2 are lower limits.
Choose suitable absolute thresholds before approving a model set.
This file describes what to train. model_set.py governs joint promotion and
scoring destinations. Branches retain manual promotion because only the complete
set receives the champion alias.
"""

from copy import deepcopy


def _unique_object(pairs):
    """Reject duplicate branch names before a declaration can disappear."""
    result = {}
    for name, value in pairs:
        if name in result:
            raise ValueError(f"Duplicate branch declaration or setting: {name}")
        result[name] = value
    return result


MODELS = _unique_object([
{{- if eq .training_layout "multi_target" -}}
{{- $comma := "" -}}
{{- range $slot := (regexp "[1-8]").FindAllString "12345678" -1 -}}
{{- if le $slot $.branch_count -}}
{{- $prefix := printf "branch_%s_" $slot -}}
{{- $task := index $ (print $prefix "task") -}}
{{- $model := index $ (print $prefix $task "_model") -}}
{{- $cv_enabled := eq (index $ (print $prefix "cv_enabled")) "true" -}}
{{- $cv_type := index $ (print $prefix "cv_type") -}}
{{- $nested := index $ (print $prefix "cv_nested_type") -}}
{{- $temporal_cv := and $cv_enabled (or (eq $cv_type "time_series_split") (and (eq $cv_type "nested_cv") (eq $nested "time_series_split"))) -}}
{{- $group_cv := or (eq $cv_type "group_k_fold") (eq $cv_type "stratified_group_k_fold") (and (eq $cv_type "nested_cv") (or (eq $nested "group_k_fold") (eq $nested "stratified_group_k_fold"))) -}}
{{- $split := index $ (print $prefix "split_strategy") -}}
{{- if $temporal_cv -}}{{- $split = "temporal" -}}{{- end -}}
{{- $window := index $ (print $prefix "training_window_mode") -}}
{{- if eq $window "auto" -}}
{{- if eq $split "temporal" -}}{{- $window = "rolling_calendar" -}}{{- else -}}{{- $window = "full_snapshot" -}}{{- end -}}
{{- end -}}
{{$comma}}
    ("{{index $ (print $prefix "name")}}", {
        "preprocessing_recipe": "{{index $ (print $prefix "preprocessing_recipe")}}",
        "pre_split_recipe": "{{index $ (print $prefix "pre_split_recipe")}}",
        "workflow": {
            "model_name": "{catalog}.{metadata_schema}.{{$.project_name}}_{{index $ (print $prefix "name")}}{resource_suffix}",
            "promotion_policy": "manual_approval",
            "score_handoff": "disabled",
            "champion_version": None,
            "task": "{{$task}}",
            "split_strategy": "{{$split}}",
            "training_window_mode": "{{$window}}",
            "lookback_days": {{if eq $window "rolling_days"}}{{template "python_value" (index $ (print $prefix "lookback_days"))}}{{else}}None{{end}},
            "holdout_days": {{if and (eq $window "rolling_days") (eq $split "temporal")}}{{template "python_value" (index $ (print $prefix "holdout_days"))}}{{else}}None{{end}},
            "window_timezone": {{if eq $window "rolling_calendar"}}"{{(index $ (print $prefix "window_timezone"))}}"{{else}}None{{end}},
            "holdout_months": {{if and (eq $window "rolling_calendar") (eq $split "temporal")}}{{(index $ (print $prefix "holdout_months"))}}{{else}}None{{end}},
            "result_availability_lag_hours": {{if eq (index $ (print $prefix "filter_unavailable_results")) "true"}}{{template "python_value" (index $ (print $prefix "result_availability_lag_hours"))}}{{else}}None{{end}},
            "test_size": {{template "python_value" (index $ (print $prefix "test_size"))}},
            "random_state": {{template "python_value" (index $ (print $prefix "random_state"))}},
            "stratify": {{if and (eq $task "classification") (ne $split "temporal")}}{{template "python_value" (index $ (print $prefix "stratify"))}}{{else}}False{{end}},
            "cv_enabled": {{if $cv_enabled}}True{{else}}False{{end}},
            "cv_folds": {{template "python_value" (index $ (print $prefix "cv_folds"))}},
            "cv_type": "{{(index $ (print $prefix "cv_type"))}}",
            "cv_nested_type": "{{if eq (index $ (print $prefix "cv_type")) "nested_cv"}}{{(index $ (print $prefix "cv_nested_type"))}}{{else}}auto{{end}}",
            "cv_group_column": {{if and $group_cv (index $ (print $prefix "cv_group_column"))}}"{{(index $ (print $prefix "cv_group_column"))}}"{{else}}None{{end}},
            "cv_gap": {{if $temporal_cv}}{{template "python_value" (index $ (print $prefix "cv_gap"))}}{{else}}0{{end}},
            "cv_test_size": {{if $temporal_cv}}{{template "python_value" (index $ (print $prefix "cv_test_size"))}}{{else}}None{{end}},
            "cv_max_train_size": {{if $temporal_cv}}{{template "python_value" (index $ (print $prefix "cv_max_train_size"))}}{{else}}None{{end}},
            "cv_shuffle": {{if or (eq (index $ (print $prefix "cv_type")) "time_series_split") (and (eq (index $ (print $prefix "cv_type")) "nested_cv") (eq (index $ (print $prefix "cv_nested_type")) "time_series_split"))}}False{{else if eq (index $ (print $prefix "cv_type")) "shuffle_split"}}True{{else}}{{template "python_value" (index $ (print $prefix "cv_shuffle"))}}{{end}},
            "cv_random_state": {{template "python_value" (index $ (print $prefix "cv_random_state"))}},
            "training_sample_rows": {{template "python_value" (index $ (print $prefix "training_sample_rows"))}},
            "training_sample_seed": {{template "python_value" (index $ (print $prefix "training_sample_seed"))}},
            "filter_unavailable_results": {{template "python_value" (index $ (print $prefix "filter_unavailable_results"))}},
            "monthly_lookback_months": {{if eq $window "rolling_calendar"}}{{template "python_value" (index $ (print $prefix "monthly_lookback_months"))}}{{else}}None{{end}},
            "input_columns": [{{range $i, $column := (regexp "[A-Za-z_][A-Za-z0-9_]*").FindAllString (index $ (print $prefix "input_columns")) -1}}{{if $i}}, {{end}}"{{$column}}"{{end}}],
            "target_column": "{{(index $ (print $prefix "target_column"))}}",
            "event_column": {{if (index $ (print $prefix "event_column"))}}"{{(index $ (print $prefix "event_column"))}}"{{else}}None{{end}},
            "result_available_at_column": {{if (index $ (print $prefix "result_available_at_column"))}}"{{(index $ (print $prefix "result_available_at_column"))}}"{{else}}None{{end}},
            "event_time_parsing": {"format": {{if (index $ (print $prefix "event_time_format"))}}"{{(index $ (print $prefix "event_time_format"))}}"{{else}}None{{end}}, "timezone": {{if (index $ (print $prefix "event_time_timezone"))}}"{{(index $ (print $prefix "event_time_timezone"))}}"{{else}}None{{end}}, "date_only": "{{(index $ (print $prefix "event_date_only"))}}"},
            "result_time_parsing": {"format": {{if (index $ (print $prefix "result_time_format"))}}"{{(index $ (print $prefix "result_time_format"))}}"{{else}}None{{end}}, "timezone": {{if (index $ (print $prefix "result_time_timezone"))}}"{{(index $ (print $prefix "result_time_timezone"))}}"{{else}}None{{end}}, "date_only": "{{(index $ (print $prefix "result_date_only"))}}"},
            "start": {{if (index $ (print $prefix "start"))}}"{{(index $ (print $prefix "start"))}}"{{else}}None{{end}},
            "holdout_start": {{if (index $ (print $prefix "holdout_start"))}}"{{(index $ (print $prefix "holdout_start"))}}"{{else}}None{{end}},
            "cutoff": {{if (index $ (print $prefix "cutoff"))}}"{{(index $ (print $prefix "cutoff"))}}"{{else}}None{{end}},
            "result_cutoff": {{if (index $ (print $prefix "result_cutoff"))}}"{{(index $ (print $prefix "result_cutoff"))}}"{{else}}None{{end}},
            "max_rows": {{template "python_value" (index $ (print $prefix "max_rows"))}},
            "max_input_mb": {{template "python_value" (index $ (print $prefix "max_input_mb"))}},
            "metric": "{{index $ (print $prefix $task "_metric")}}",
            "min_improvement": {{template "python_value" (index $ (print $prefix "min_improvement"))}},
            "quality_threshold": {{template "python_value" (index $ (print $prefix "quality_threshold"))}},
            "cv_inner_folds": {{if and (eq (index $ (print $prefix "cv_type")) "nested_cv") (index $ (print $prefix "cv_inner_folds"))}}{{template "python_value" (index $ (print $prefix "cv_inner_folds"))}}{{else}}None{{end}},
            "quality_gates": {{template "python_value" (index $ (print $prefix "quality_gates"))}},
            "pipeline": {
                "preprocessing": [],
{{if eq $.shap_enabled "true"}}                "explainability": {
                    "method": "shap",
                    "max_samples": {{$.shap_max_samples}},
                    "max_features": {{$.shap_max_features}},
                    "max_display_samples": {{$.shap_max_display_samples}},
                },
{{end}}
                "modeling": {{template "modeling" (map (pair "indent" "                ") (pair "values" $) (pair "prefix" $prefix) (pair "model" $model) (pair "task" $task) (pair "ensemble_prefix" (printf "branch_%s_ensemble_" $slot)))}}
            }
        }
    })
{{- $comma = "," -}}
{{- end -}}
{{- end -}}
{{- end }}
])


def build_training_branches():
    """Return fresh independent branch declarations for the selected training layout."""
    return deepcopy(MODELS)
