# Scoring controls and output destinations. No model is trained by this file.
version: 1
prediction_delivery: {{.prediction_delivery}}
{{if ne .prediction_delivery "endpoint"}}batch_compute: {{.batch_compute}}
# from_now checkpoints without predictions on the first run; rebuilds keep that boundary.
initial_scoring: {{.initial_scoring}}
{{if eq .batch_compute "spark"}}spark_udf_env_manager: {{if eq .compute_mode "serverless"}}local{{else}}virtualenv{{end}}
spark_udf_prediction_batch_rows: 10000
{{end}}{{end}}score_source_table: "{catalog}.{input_schema}.{{if .score_source_table_name}}{{.score_source_table_name}}{{else}}{{if .source_table_name}}{{.source_table_name}}{{else}}{{.project_name}}_source{{end}}{{end}}"
{{if ne .prediction_delivery "endpoint"}}prediction_table: "{catalog}.{output_schema}.{{if .prediction_table_name}}{{.prediction_table_name}}{{else}}{{.project_name}}_predictions{{end}}{resource_suffix}"
score_model_selection: {{.score_model_selection}}
{{if eq .score_model_selection "pinned_version"}}model_version: "1"
{{end}}on_model_change: {{.on_model_change}}
rescore_when_history_expires: {{.rescore_when_history_expires}}
follow_champion: {{.score_follow_champion}}
{{end}}{{if eq .training_layout "multi_target"}}model_set:
  model_name: "{catalog}.{metadata_schema}.{{if .model_set_name}}{{.model_set_name}}{{else}}{{.project_name}}_set{{end}}{resource_suffix}"
{{if ne .prediction_delivery "endpoint"}}  prediction_table: "{catalog}.{output_schema}.{{if .model_set_table_name}}{{.model_set_table_name}}{{else}}{{.project_name}}_set_scores{{end}}{resource_suffix}"
{{end}}  promotion_policy: {{.model_set_promotion_policy}}
  combined_rules_path: ../features
{{if ne .prediction_delivery "endpoint"}}  on_source_change: {{.on_source_change}}
  publication:
    mode: {{.model_set_output_mode}}
{{if eq .model_set_output_mode "separate_views"}}    model_view_template: "{catalog}.{output_schema}.{{if .model_view_prefix}}{{.model_view_prefix}}{{else}}{{.project_name}}_predictions{{end}}_{branch}{resource_suffix}"
    combined_view: "{catalog}.{output_schema}.{{if .combined_view_name}}{{.combined_view_name}}{{else}}{{.project_name}}_business_results{{end}}{resource_suffix}"
{{end}}{{end}}{{end}}
