# Stable endpoint setup is ready to run when selected at initialization.
# Enable rollout and online-feature jobs only after completing their settings.
# The rollout must already be initialized; the daily job never creates endpoints.
{{if ne .prediction_delivery "batch" -}}
{{- $endpoint := (regexp "_").ReplaceAllString .project_name "-" -}}
{{- $endpoint = printf "%s-endpoint" $endpoint -}}
{{- if not ((regexp "^[A-Za-z][A-Za-z0-9_-]{0,62}$").MatchString $endpoint) -}}
{{- template "ERROR_project_name_requires_safe_serving_endpoint_name_of_at_most_63_characters" . -}}
{{- end }}
serving_endpoint:
  enabled: true
  follow_champion: {{.serving_follow_champion}}  # false = manual runs only
  # Target substitutions are resolved by the job; development gets a per-user suffix.
  endpoint_name: "{{(regexp "_").ReplaceAllString .project_name "-"}}-{bundle_target}-endpoint{resource_suffix}"
  model_name: "{catalog}.{metadata_schema}.{{if eq .training_layout "multi_target"}}{{if .model_set_name}}{{.model_set_name}}{{else}}{{.project_name}}_set{{end}}{{else}}{{.project_name}}_model{{end}}{resource_suffix}"
  tracking_uri: databricks
  registry_uri: databricks-uc
  workload_type: {{.serving_workload_type}}
  workload_size: {{.serving_workload_size}}
  scale_to_zero_enabled: {{.serving_scale_to_zero_enabled}}
  ready_timeout_s: {{.serving_ready_timeout_s}}
  logging_mode: {{.serving_endpoint_logging_mode}}
{{if eq .serving_endpoint_logging_mode "disabled"}}  logging_catalog: ""
  logging_schema: ""
  logging_table_prefix: ""
{{else}}  logging_catalog: "{catalog}"
  logging_schema: "{metadata_schema}"
  logging_table_prefix: "{{if .serving_endpoint_logging_table_prefix}}{{.serving_endpoint_logging_table_prefix}}{{else}}{{.project_name}}_serving{{end}}{resource_suffix}"
{{end}}  sql_function:
    enabled: true
    name: "{catalog}.{metadata_schema}.{{.project_name}}_score{resource_suffix}"
  # Additive grants only. Removing an entry does not revoke access.
  permissions: [] # e.g. [{group_name: data_products, level: CAN_QUERY}]
  verification:
    sample_rows: 20 # Bounded sample from config/inference.yml score_source_table; zero rows fails.

{{end -}}
{{if eq .include_online_feature_lookup "true"}}online_feature_lookup:
  enabled: false
  # Set true only when no other job or person changes this endpoint. Existing endpoints are never overwritten.
  exclusive_writer: false
  tracking_uri: databricks
  registry_uri: databricks-uc
  endpoint:
    endpoint_name: ""
    model_name: ""
    model_version: "" # A registered model version number, such as 7; not a name like champion.
    workload_type: {{.serving_workload_type}} # CPU | CPU_MEDIUM | CPU_LARGE
    workload_size: {{.serving_workload_size}} # Small | Medium | Large
    scale_to_zero_enabled: {{.serving_scale_to_zero_enabled}}
    ready_timeout_s: {{.serving_ready_timeout_s}} # Setup waits for READY + NOT_UPDATING.
{{- if eq .serving_logging_mode "disabled"}}
    logging_catalog: ""
    logging_schema: ""
    logging_table_prefix: ""
{{- else}}
    # Databricks writes <logging_catalog>.<logging_schema>.<logging_table_prefix>_payload.
    logging_catalog: "{{.catalog}}"
    logging_schema: "{{.schema}}"
    logging_table_prefix: "{{if .serving_logging_table_prefix}}{{.serving_logging_table_prefix}}{{else}}{{.project_name}}_endpoint{{end}}"
{{- end}}
    # telemetry | ai_gateway | disabled (no inference table; no rollout or serving monitoring).
    logging_mode: {{.serving_logging_mode}}
  # Exactly one existing accessible online copy per lookup source, including external publication.
  publications:
    - source_table: ""
      source_table_id: ""
      online_table: ""
      online_store: ""
      publish_mode: {{if eq .include_online_publication "true"}}{{.online_publication_mode}}{{else}}TRIGGERED{{end}} # Match the existing publication's mode.

{{end -}}
rollout:
  enabled: false
  # Set true only when no other job or person changes this endpoint or its champion assignment.
  exclusive_writer: false
  run_id: ""
  tracking_uri: databricks
  registry_uri: databricks-uc
  comparison_sha256: ""
  approval:
    model_name: ""
    metric: {{if eq .task "classification"}}heldout_accuracy{{else}}heldout_rmse{{end}}
    min_improvement: 0.0
    min_scored_fraction: {{.min_scored_fraction}}
    max_coverage_drop: {{.max_coverage_drop}}
    quality_threshold: null
    quality_gates: null
    max_rows: 10000
    max_input_mb: 64
    tracking_uri: databricks
    registry_uri: databricks-uc
  # Example requests with the saved model input columns; both model versions are checked.
  smoke_records: []
  health:
    minimum_requests: 100
    maximum_error_rate: 0.01
    # Bounds p99 model execution time; absent/null p99 falls back to the maximum.
    maximum_latency_ms: 1000.0
    minimum_labeled_rows: 30
    minimum_label_coverage: 0.8
  monitoring:
    environment: syst # Fallback label; the daily_rollout job records its Bundle target instead.
    project: {{.project_name}}
    model_name: ""
    model_version: ""
    serving_endpoint: ""
    # Both names select the same pinned endpoint inference payload table.
    source_table: ""
    prediction_table: ""
    # Labels retain databricks_request_id and request_row_index for request attribution.
    label_table: ""
    result_available_at_column: ""
    execution_engine: spark
    reference_namespace: ""

online_publication:
  enabled: false
  publish_mode: {{.online_publication_mode}}
  # Set true only when other writers cannot change this source or publication while this job runs.
  exclusive_writer: false
  # Existing Delta feature table with one current row per key, change data feed enabled, and no null keys.
  source_table: ""
  source_table_id: ""
  online_table: ""
  online_store: ""
