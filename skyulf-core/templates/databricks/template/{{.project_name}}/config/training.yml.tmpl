{{- if and (eq .batch_compute "spark") (eq .engine "polars") -}}
{{- template "ERROR_batch_compute_spark_requires_engine_pandas" . -}}
{{- end -}}
{{- $source := .source_table_name -}}{{- if not $source -}}{{- $source = printf "%s_source" .project_name -}}{{- end -}}
{{- $sourcePattern := printf "(?i)^(%s|%s\\.%s\\.%s)$" $source .catalog .schema $source -}}
{{- $scorePattern := printf "(?i)^(%s|%s\\.%s\\.%s)$" .score_source_table_name .catalog .schema .score_source_table_name -}}
{{- if and (ne .source_layout "single_table") (or ((regexp $sourcePattern).MatchString .label_table_name) (and .score_source_table_name ((regexp $scorePattern).MatchString .label_table_name))) -}}
{{- template "ERROR_source_layout_requires_distinct_outcomes_table" . -}}
{{- end -}}
{{- if and (ne .source_layout "single_table") (or (not .label_table_name) (not .label_available_at_column)) -}}
{{- template "ERROR_source_layout_requires_label_table_name_and_label_available_at_column" . -}}
{{- end -}}
{{- if and (eq .source_layout "separate_outcomes") .score_source_table_name (ne .score_source_table_name $source) -}}
{{- template "ERROR_source_layout_separate_outcomes_requires_same_training_and_scoring_source" . -}}
{{- end -}}
{{- if and (eq .source_layout "separate_all") (or (not .score_source_table_name) (eq .score_source_table_name $source)) -}}
{{- template "ERROR_source_layout_separate_all_requires_distinct_score_source_table_name" . -}}
{{- end -}}
{{- if and (eq .include_online_feature_lookup "true") (or (eq .training_layout "multi_target") (ne .engine "pandas")) -}}
{{- template "ERROR_online_feature_lookup_requires_engine_pandas_and_single_model_or_competition" . -}}
{{- end -}}
{{- if and (ne .prediction_delivery "batch") (ne .engine "pandas") -}}
{{- template "ERROR_serving_endpoint_requires_engine_pandas" . -}}
{{- end -}}
{{- if ne .include_examples "true" -}}
{{- $recipes := .competition_preprocessing_recipe -}}
{{- range $slot := (regexp "[1-8]").FindAllString "12345678" -1 -}}
{{- $recipes = printf "%s %s %s" $recipes (index $ (printf "branch_%s_preprocessing_recipe" $slot)) (index $ (printf "branch_%s_pre_split_recipe" $slot)) -}}
{{- end -}}
{{- if (regexp "(^| )example_").MatchString $recipes -}}
{{- template "ERROR_include_examples_false_cannot_select_example_recipes" . -}}
{{- end -}}
{{- end -}}
{{- /* Core competition admission rejects these; test_databricks_wizard_guards.py checks Core. */ -}}
{{- $unsupported_competition_metrics := "^heldout_(mape|precision_weighted|recall_weighted)$" -}}
{{- if and (eq .training_layout "model_competition") ((regexp $unsupported_competition_metrics).MatchString (index . (printf "%s_metric" .task))) -}}
{{- template "ERROR_metric_is_not_supported_for_model_competition" . -}}
{{- end -}}
# Shared training settings; model entries override whole values from defaults.
# Custom transformations stay in src/features. Scoring uses the saved fitted model.
# preprocessing_recipe selects a list in config/preprocessing.yml.
# pre_split_recipe selects a list in config/pre_split.yml.
# Keep custom functions in src/features/preprocessing.py and pre_split.py.
# See PREPROCESSING.md; do not add pipeline.preprocessing here.
version: 1
defaults:
  config_version: 1
  training_layout: {{.training_layout}}
  engine: {{.engine}}
{{if eq .include_online_feature_lookup "true"}}  # Complete these declarations before training; all lookup outputs must be input_columns.
  # Use pandas and non-temporal lookups. Each lookup needs a fitted DOUBLE UTC epoch field.
  feature_lookup:
    lookups:
      - table_name: ""
        lookup_key: []
        feature_names: []
  online_features:
    required_features: []
    freshness:
      - column: ""
        max_age_seconds: null
{{end}}
  save_preprocessing_diagnostics: {{.save_preprocessing_diagnostics}} # Optional preprocessing diagnostics; first 256 holdout rows, 8 MiB. See PREPROCESSING_CONTEXT.md.
  # Spark and online-feature projects check admission automatically, even when false below.
  # Set true to check preprocessing during training and save the results needed for endpoint deployment.
  # Details: https://www.skyulf.com/manual/user_guide/databricks_spark_scoring.html
  probe_pipeline_for_serving: {{if ne .prediction_delivery "batch"}}true{{else}}false{{end}}
  training_table: "{catalog}.{input_schema}.{{if .source_table_name}}{{.source_table_name}}{{else}}{{.project_name}}_source{{end}}"
{{if eq .source_layout "separate_outcomes"}}  training_label_table: "{{if not ((regexp "\\.").MatchString .label_table_name)}}{catalog}.{input_schema}.{{end}}{{.label_table_name}}"
  # null uses the latest label-table version at run start; set a number to reuse a specific version.
  training_label_table_version: null
{{end -}}
{{if ne .training_table_version "null"}}  training_table_version: {{.training_table_version}}
{{end}}  record_key_columns: [{{range $i, $column := (regexp "[A-Za-z_][A-Za-z0-9_]*").FindAllString .record_key_columns -1}}{{if $i}}, {{end}}{{printf "%q" $column}}{{end}}]
  model_name: "{catalog}.{metadata_schema}.{{.project_name}}_model{resource_suffix}"
  promotion_policy: {{.promotion_policy}}
{{if .risk_category}}  risk_category: {{printf "%q" .risk_category}}
{{end}}  evaluation_charts: {enabled: {{.evaluation_charts_enabled}}}
{{if eq .shap_enabled "true"}}  explainability: {method: shap, max_samples: {{.shap_max_samples}}, max_features: {{.shap_max_features}}, max_display_samples: {{.shap_max_display_samples}}}
{{end -}}
{{if ne .training_layout "multi_target"}}{{template "training_settings" (map (pair "values" .) (pair "prefix" "") (pair "indent" "  ") (pair "task" .task))}}{{end -}}
{{if eq .training_layout "model_competition"}}  competition_max_trials: {{.competition_max_trials}}
  competition_max_candidates: 8
  preprocessing_recipe: {{.competition_preprocessing_recipe}}
{{end}}models:
{{if eq .training_layout "single_model" -}}
{{- $model := index . (printf "%s_model" .task) -}}
{{- if eq .sample_weight_enabled "true" -}}{{- $model = index . (printf "%s_model_weighted" .task) -}}{{- end}}
  main:
{{template "modeling" (map (pair "values" .) (pair "prefix" "") (pair "indent" "    ") (pair "model" $model) (pair "task" .task) (pair "ensemble_prefix" "single_ensemble_"))}}
{{- else if eq .training_layout "model_competition" -}}
{{- range $slot := (regexp "[1-8]").FindAllString "12345678" -1 -}}{{- if le $slot $.competition_candidate_count -}}
{{- $model := index $ (printf "competition_%s_model_%s" $.task $slot) -}}
{{- if eq $.sample_weight_enabled "true" -}}{{- $model = index $ (printf "competition_%s_model_%s_weighted" $.task $slot) -}}{{- end}}
  {{$model}}_{{$slot}}:
{{template "modeling" (map (pair "values" $) (pair "prefix" "") (pair "indent" "    ") (pair "model" $model) (pair "task" $.task) (pair "ensemble_prefix" (printf "competition_ensemble_%s_" $slot)))}}
{{- end -}}{{- end -}}
{{- else -}}
{{- range $slot := (regexp "[1-8]").FindAllString "12345678" -1 -}}{{- if le $slot $.branch_count -}}
{{- $p := printf "branch_%s_" $slot -}}{{- $task := index $ (print $p "task") -}}
{{- $model := index $ (print $p $task "_model") -}}
{{- if eq (index $ (print $p "sample_weight_enabled")) "true" -}}{{- $model = index $ (print $p $task "_model_weighted") -}}{{- end}}
  {{printf "%q" (index $ (print $p "name"))}}:
    model_name: "{catalog}.{metadata_schema}.{{$.project_name}}_{{index $ (print $p "name")}}{resource_suffix}"
    preprocessing_recipe: {{index $ (print $p "preprocessing_recipe")}}
    pre_split_recipe: {{index $ (print $p "pre_split_recipe")}}
{{template "training_settings" (map (pair "values" $) (pair "prefix" $p) (pair "indent" "    ") (pair "task" $task))}}
{{template "modeling" (map (pair "values" $) (pair "prefix" $p) (pair "indent" "    ") (pair "model" $model) (pair "task" $task) (pair "ensemble_prefix" (printf "branch_%s_ensemble_" $slot)))}}
{{- end -}}{{- end -}}{{- end}}
