{{- $competition := eq .training_layout "model_competition" -}}
{{- $cv_enabled := or $competition (eq .cv_enabled "true") -}}
{{- $temporal_cv := and $cv_enabled (or (eq .cv_type "time_series_split") (and (eq .cv_type "nested_cv") (eq .cv_nested_type "time_series_split"))) -}}
{{- $split := .split_strategy -}}
{{- if $temporal_cv -}}{{- $split = "temporal" -}}{{- end -}}
{{- $window := .training_window_mode -}}
{{- if eq $window "auto" -}}
{{- if eq $split "temporal" -}}{{- $window = "rolling_calendar" -}}{{- else -}}{{- $window = "full_snapshot" -}}{{- end -}}
{{- end -}}
{
  "config_version": 1,
  "training_layout": "{{.training_layout}}",
  "evaluation_charts": {"enabled": {{.evaluation_charts_enabled}}, "max_rows": 2000, "max_features": 20, "max_classes": 20},
{{if $competition}}  "competition_max_trials": {{.competition_max_trials}},
  "competition_max_candidates": 8,
{{end}}
  "task": "{{.task}}",
  "engine": "{{.engine}}",
  "split_strategy": "{{$split}}",
  "training_window_mode": "{{$window}}",
  "window_timezone": {{if eq $window "rolling_calendar"}}"{{.window_timezone}}"{{else}}null{{end}},
  "holdout_months": {{if and (eq $window "rolling_calendar") (eq $split "temporal")}}{{.holdout_months}}{{else}}null{{end}},
  "result_availability_lag_hours": {{if eq .filter_unavailable_results "true"}}{{.result_availability_lag_hours}}{{else}}null{{end}},
  "test_size": {{.test_size}},
  "random_state": {{.random_state}},
  "stratify": {{.stratify}},
  "cv_enabled": {{$cv_enabled}},
  "cv_folds": {{.cv_folds}},
{{if .cv_inner_folds}}  "cv_inner_folds": {{.cv_inner_folds}},
{{end}}
  "cv_type": "{{.cv_type}}",
  "cv_nested_type": "{{.cv_nested_type}}",
  "cv_group_column": {{if .cv_group_column}}"{{.cv_group_column}}"{{else}}null{{end}},
  "cv_gap": {{.cv_gap}},
  "cv_test_size": {{.cv_test_size}},
  "cv_max_train_size": {{.cv_max_train_size}},
  "cv_shuffle": {{if or (eq .cv_type "time_series_split") (and (eq .cv_type "nested_cv") (eq .cv_nested_type "time_series_split"))}}false{{else if eq .cv_type "shuffle_split"}}true{{else}}{{.cv_shuffle}}{{end}},
  "cv_random_state": {{.cv_random_state}},
  "training_sample_rows": {{.training_sample_rows}},
  "training_sample_seed": {{.training_sample_seed}},
  "filter_unavailable_results": {{.filter_unavailable_results}},
  "training_table": "{catalog}.{input_schema}.{{if .source_table_name}}{{.source_table_name}}{{else}}{{.project_name}}_source{{end}}",
  "training_version": {{.training_version}},
  "monthly_lookback_months": {{if eq $window "rolling_calendar"}}{{.monthly_lookback_months}}{{else}}null{{end}},
  "score_source_table": "{catalog}.{input_schema}.{{if .score_source_table_name}}{{.score_source_table_name}}{{else}}{{if .source_table_name}}{{.source_table_name}}{{else}}{{.project_name}}_source{{end}}{{end}}",
  "prediction_table": "{catalog}.{output_schema}.{{if .prediction_table_name}}{{.prediction_table_name}}{{else}}{{.project_name}}_predictions{{end}}{resource_suffix}",
  "model_name": "{catalog}.{metadata_schema}.{{.project_name}}_model{resource_suffix}",
  "model_version": "1",
  "model_change_mode": "{{.model_change_mode}}",
  "auto_rebuild_on_cdf_expiry": {{.auto_rebuild_on_cdf_expiry}},
  "score_model_selection": "{{.score_model_selection}}",
  "promotion_policy": "{{.promotion_policy}}",
  "score_handoff": "{{.score_handoff}}",
  "champion_version": null,
  "risk_category": {{if .risk_category}}"{{.risk_category}}"{{else}}null{{end}},
  "record_key_columns": [{{range $i, $column := (regexp "[A-Za-z_][A-Za-z0-9_]*").FindAllString .record_key_columns -1}}{{if $i}}, {{end}}"{{$column}}"{{end}}],
  "input_columns": [{{range $i, $column := (regexp "[A-Za-z_][A-Za-z0-9_]*").FindAllString .input_columns -1}}{{if $i}}, {{end}}"{{$column}}"{{end}}],
  "target_column": "{{.target_column}}",
  "event_column": {{if .event_column}}"{{.event_column}}"{{else}}null{{end}},
  "result_available_at_column": {{if .result_available_at_column}}"{{.result_available_at_column}}"{{else}}null{{end}},
  "event_time_parsing": {"format": {{if .event_time_format}}"{{.event_time_format}}"{{else}}null{{end}}, "timezone": {{if .event_time_timezone}}"{{.event_time_timezone}}"{{else}}null{{end}}, "date_only": "{{.event_date_only}}"},
  "result_time_parsing": {"format": {{if .result_time_format}}"{{.result_time_format}}"{{else}}null{{end}}, "timezone": {{if .result_time_timezone}}"{{.result_time_timezone}}"{{else}}null{{end}}, "date_only": "{{.result_date_only}}"},
  "start": {{if .start}}"{{.start}}"{{else}}null{{end}},
  "holdout_start": {{if .holdout_start}}"{{.holdout_start}}"{{else}}null{{end}},
  "cutoff": {{if .cutoff}}"{{.cutoff}}"{{else}}null{{end}},
  "result_cutoff": {{if .result_cutoff}}"{{.result_cutoff}}"{{else}}null{{end}},
  "max_rows": {{.max_rows}},
  "max_input_mb": {{.max_input_mb}},
  "metric": "{{if eq .task "classification"}}{{.classification_metric}}{{else}}{{.regression_metric}}{{end}}",
  "min_improvement": {{.min_improvement}},
  "quality_threshold": {{.quality_threshold}},
  "pipeline": {
    "preprocessing": [],
{{if eq .shap_enabled "true"}}    "explainability": {
      "method": "shap",
      "max_samples": {{.shap_max_samples}},
      "max_features": {{.shap_max_features}},
      "max_display_samples": {{.shap_max_display_samples}}
    },
{{end}}
    "modeling": {{if or $competition (eq .training_layout "multi_target")}}{
      "type": "{{if eq .task "classification"}}logistic_regression{{else}}ridge_regression{{end}}",
      "params": {}
    }{{else}}{}{{end}}
  }
}
