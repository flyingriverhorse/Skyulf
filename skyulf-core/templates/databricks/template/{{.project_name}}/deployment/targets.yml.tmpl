{{end}}
{{if eq .manage_job_permissions "true"}}
          permissions: ${var.train_permissions}
{{end}}
{{if ne .prediction_delivery "batch"}}        serving_endpoint:
{{if eq .deployment_identity "shared_service_principal"}}
          run_as:
            service_principal_name: ${var.shared_service_principal}
{{end}}
{{if eq .deployment_identity "separate_service_principals"}}
          run_as:
            service_principal_name: ${var.score_service_principal}
{{end}}
          permissions: ${var.serving_permissions}
{{end}}{{if ne .prediction_delivery "endpoint"}}        score:
{{if eq .deployment_identity "shared_service_principal"}}
          run_as:
            service_principal_name: ${var.shared_service_principal}
{{end}}
{{if eq .deployment_identity "separate_service_principals"}}
          run_as:
            service_principal_name: ${var.score_service_principal}
{{end}}
{{if eq .manage_job_permissions "true"}}
          permissions: ${var.score_permissions}
{{end}}
{{end}}        monitoring:
{{if eq .deployment_identity "shared_service_principal"}}
          run_as:
            service_principal_name: ${var.shared_service_principal}
{{end}}
{{if eq .deployment_identity "separate_service_principals"}}
          run_as:
            service_principal_name: ${var.score_service_principal}
{{end}}
{{if eq .manage_job_permissions "true"}}
          permissions: ${var.monitoring_permissions}
{{end}}
{{if eq .monitoring "true"}}
        monitoring_cleanup:
{{if eq .deployment_identity "shared_service_principal"}}
          run_as:
            service_principal_name: ${var.shared_service_principal}
{{end}}
{{if eq .deployment_identity "separate_service_principals"}}
          run_as:
            service_principal_name: ${var.score_service_principal}
{{end}}
{{if eq .manage_job_permissions "true"}}
          permissions: ${var.monitoring_permissions}
{{end}}
{{end}}
{{end}}
