{{- $id := "" -}}
{{- if and (eq .monitoring_dashboard "connect") .monitoring_dashboard_url -}}
{{- $id = index ((regexp "dashboardsv3/([0-9a-fA-F-]+)").FindStringSubmatch .monitoring_dashboard_url) 1 -}}
{{- end -}}
{{- $create := eq .monitoring_dashboard "create" -}}
{{- $connect := eq .monitoring_dashboard "connect" -}}
{{- $devmon := and (eq .monitoring "true") (eq .development_monitoring "true") -}}
{{- $acl := or (ne .deployment_identity "deployer") (eq .manage_job_permissions "true") -}}
{{- $testdash := or $create $connect -}}
{{- $devdash := and $create $devmon -}}
# Every Bundle target is defined in this file only; other deployment files hold variables.
# Shared environments are independent of your CI/CD provider.
# Personal development targets deliberately have no shared run_as or job ACL overrides.
# Every target lets the deployer and pipeline_owner manage its resources;
# shared targets can add a read-only group chosen in setup.
# Personal targets use Databricks' development prefix, so their jobs are named
# "[dev <your short name>] <project>_train" and keep the project in the name.
#
# Monitoring per target:
# - test, syst and prod write to monitoring_catalog.monitoring_schema. Both are in
#   deployment/variables.yml; monitoring_catalog defaults to each target's own
#   catalog. To use another name in one target, set it under that target's
#   variables, for example `monitoring_schema: mlops_monitoring`.
# - Development targets write to monitoring_catalog.development_monitoring_schema
#   (variables.yml) only when their block sets monitoring_enabled: "true".
#   That schema must differ from monitoring_schema; dev models never enter the
#   shared store. Development never retrains or runs scheduled monitoring.
# All monitoring tables and views are created in that one schema on first use.
#
# Dashboards (optional): one dashboard per workspace shows every model in a
# monitoring store. For each target choose one, then deploy that target:
#   create  - only in the FIRST project that uses this target's monitoring store.
#             Deploy creates the dashboard. Every other project connects to it.
#   connect - paste the dashboard's published URL and its ID (the 32 characters
#             after /dashboardsv3/ in that URL).
#   nothing - leave the dashboard out.
# warehouse_id is the SQL warehouse that runs the dashboard queries:
# SQL Warehouses > your warehouse > Connection details (16 hexadecimal
# characters); it is also in the warehouse page URL, .../sql/warehouses/<id>.
# Each workspace has its own warehouses, so syst and prod need their own ID.
# A development target can only create its own dashboard over the development
# store; never connect it to a shared dashboard.
#
# A target's `resources.jobs.monitoring` repeats the job name from
# resources/monitoring.job.yml, so Bundle does not create a second job: on
# `bundle deploy -t <target>` it adds each task_key it does not know yet
# (dashboard_refresh_enabled and refresh_monitoring_dashboard) after
# evaluate_retraining, and run_as/permissions the same way. Commented create and
# connect examples for another target are at the end of this file.
#
# Duration warnings: add `health: {rules: [...]}` to a job under a target's
# resources.jobs; jobs have no health block by default.
targets:
  test:
    mode: production
    default: false
    permissions:
      - level: CAN_MANAGE
        user_name: ${workspace.current_user.userName}
      - level: CAN_MANAGE
        user_name: ${var.pipeline_owner}
{{- if .test_view_group}}
      - level: CAN_VIEW
        group_name: {{printf "%q" .test_view_group}}
{{- end}}
    workspace:
      host: https://replace-test.example.invalid
      root_path: ${var.test_root_path}
    variables:
      catalog: ${var.test_catalog}
      input_schema: ${var.test_input_schema}
      output_schema: ${var.test_output_schema}
      metadata_schema: ${var.test_metadata_schema}
      resource_suffix: ""
{{- if $create}}
      # Dashboard: create. This project creates and owns this target's dashboard;
      # other projects connect to it.
      monitoring_dashboard_url: ${workspace.host}/dashboardsv3/${resources.dashboards.monitoring_dashboard.id}/published
{{- else if $connect}}
      # Dashboard: connect. Another project created it; this target only refreshes it.
      monitoring_dashboard_url: {{printf "%q" .monitoring_dashboard_url}}
{{- end}}
{{if or $acl $testdash}}
    resources:
{{- if $create}}
      dashboards:
        monitoring_dashboard:
          display_name: "${bundle.name} monitoring"
          file_path: ../src/monitoring/monitoring.lvdash.json
          warehouse_id: {{printf "%q" .monitoring_dashboard_warehouse_id}}
          dataset_catalog: ${var.monitoring_catalog}
          dataset_schema: ${var.monitoring_schema}
          embed_credentials: false
{{- end}}
      jobs:
{{if $acl}}
        train:
{{if eq .deployment_identity "shared_service_principal"}}
          run_as:
            service_principal_name: ${var.shared_service_principal}
{{end}}
{{if eq .deployment_identity "separate_service_principals"}}
          run_as:
            service_principal_name: ${var.train_service_principal}
{{end}}
{{if eq .manage_job_permissions "true"}}
          permissions: ${var.train_permissions}
{{end}}
{{if ne .prediction_delivery "batch"}}        serving_endpoint:
{{if eq .deployment_identity "shared_service_principal"}}
          run_as:
            service_principal_name: ${var.shared_service_principal}
{{end}}
{{if eq .deployment_identity "separate_service_principals"}}
          run_as:
            service_principal_name: ${var.score_service_principal}
{{end}}
          permissions: ${var.serving_permissions}
{{end}}{{if ne .prediction_delivery "endpoint"}}        score:
{{if eq .deployment_identity "shared_service_principal"}}
          run_as:
            service_principal_name: ${var.shared_service_principal}
{{end}}
{{if eq .deployment_identity "separate_service_principals"}}
          run_as:
            service_principal_name: ${var.score_service_principal}
{{end}}
{{if eq .manage_job_permissions "true"}}
          permissions: ${var.score_permissions}
{{end}}
{{end}}
{{end}}
        monitoring:
{{if eq .deployment_identity "shared_service_principal"}}
          run_as:
            service_principal_name: ${var.shared_service_principal}
{{end}}
{{if eq .deployment_identity "separate_service_principals"}}
          run_as:
            service_principal_name: ${var.score_service_principal}
{{end}}
{{if eq .manage_job_permissions "true"}}
          permissions: ${var.monitoring_permissions}
{{end}}
{{- if $testdash}}
          tasks:
            - task_key: dashboard_refresh_enabled
              description: Refresh only when monitoring is enabled
              depends_on:
                - task_key: evaluate_retraining
              condition_task:
                op: EQUAL_TO
                left: "${var.monitoring_enabled}"
                right: "true"
            - task_key: refresh_monitoring_dashboard
              depends_on:
                - task_key: dashboard_refresh_enabled
                  outcome: "true"
              timeout_seconds: ${var.monitoring_task_timeout_seconds}
              dashboard_task:
{{- if $create}}
                dashboard_id: ${resources.dashboards.monitoring_dashboard.id}
{{- else}}
                dashboard_id: {{printf "%q" $id}}
{{- if .monitoring_dashboard_warehouse_id}}
                warehouse_id: {{printf "%q" .monitoring_dashboard_warehouse_id}}
{{- end}}
{{- end}}
{{- end}}
{{if and $acl (eq .monitoring "true")}}
        monitoring_cleanup:
{{if eq .deployment_identity "shared_service_principal"}}
          run_as:
            service_principal_name: ${var.shared_service_principal}
{{end}}
{{if eq .deployment_identity "separate_service_principals"}}
          run_as:
            service_principal_name: ${var.score_service_principal}
{{end}}
{{if eq .manage_job_permissions "true"}}
          permissions: ${var.monitoring_permissions}
{{end}}
{{end}}
{{end}}
{{if eq .personal_development_targets "true"}}
  test_development:
    mode: development
    default: true
    permissions:
      - level: CAN_MANAGE
        user_name: ${workspace.current_user.userName}
      - level: CAN_MANAGE
        user_name: ${var.pipeline_owner}
    presets:
      trigger_pause_status: PAUSED
{{- if $devdash}}
    resources:
      dashboards:
        monitoring_dashboard:
          # Your own dashboard over the development store (development mode prefixes its name).
          display_name: "${bundle.name} monitoring"
          file_path: ../src/monitoring/monitoring.lvdash.json
          warehouse_id: {{printf "%q" .monitoring_dashboard_warehouse_id}}
          dataset_catalog: ${var.monitoring_catalog}
          dataset_schema: ${var.development_monitoring_schema}
          embed_credentials: false
      jobs:
        monitoring:
          tasks:
            - task_key: dashboard_refresh_enabled
              description: Refresh only when monitoring is enabled
              depends_on:
                - task_key: evaluate_retraining
              condition_task:
                op: EQUAL_TO
                left: "${var.monitoring_enabled}"
                right: "true"
            - task_key: refresh_monitoring_dashboard
              depends_on:
                - task_key: dashboard_refresh_enabled
                  outcome: "true"
              timeout_seconds: ${var.monitoring_task_timeout_seconds}
              dashboard_task:
                dashboard_id: ${resources.dashboards.monitoring_dashboard.id}
{{- end}}
    workspace:
      host: https://replace-test.example.invalid
      root_path: /Workspace/Users/${workspace.current_user.userName}/.bundle/${bundle.name}/test_development
    variables:
      catalog: ${var.test_catalog}
      input_schema: ${var.test_development_input_schema}
      output_schema: ${var.test_development_output_schema}
      metadata_schema: ${var.test_development_metadata_schema}
      resource_suffix: _test_dev_${workspace.current_user.id}
{{- if $devmon}}
      # Development monitoring writes to development_monitoring_schema, never to
      # the shared monitoring_schema.
      monitoring_enabled: "true"
{{- else}}
      # Development monitoring is off; dev models never enter the shared store. To
      # turn it on, set development_monitoring_schema in deployment/variables.yml
      # (it needs monitoring), then set monitoring_enabled: "true" here.
      monitoring_enabled: "false"
{{- end}}
      monitoring_pause_status: PAUSED
      monitoring_cleanup_pause_status: PAUSED
      monitoring_performance_policies: '{}'
      on_drift: disabled
{{- if $devdash}}
      # Dashboard: create (development store only).
      monitoring_dashboard_url: ${workspace.host}/dashboardsv3/${resources.dashboards.monitoring_dashboard.id}/published
{{- end}}
{{if eq .retraining_mode "scheduled"}}
      retraining_pause_status: PAUSED
{{end}}
{{if and (ne .prediction_delivery "endpoint") (eq .scoring_mode "scheduled")}}
      scoring_pause_status: PAUSED
{{end}}
{{end}}

