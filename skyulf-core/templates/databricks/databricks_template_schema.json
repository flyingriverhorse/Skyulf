{
  "welcome_message": "Create a bounded Skyulf pandas/Polars Bundle. dev is ready for your CLI profile; edit test, syst and prod target settings before using them.",
  "properties": {
    "project_name": {
      "order": 1,
      "type": "string",
      "default": "skyulf_local",
      "description": "Bundle name (letters, digits and underscores)",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "engine": {
      "order": 2,
      "type": "string",
      "default": "pandas",
      "description": "Local fit and prediction engine",
      "enum": ["pandas", "polars"]
    },
    "row_key": {
      "order": 3,
      "type": "string",
      "default": "entity_id",
      "description": "Existing source column identifying one prediction row (also copied to output)",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "retraining_mode": {
      "order": 12,
      "type": "string",
      "default": "manual",
      "description": "Train manually, or add a paused monthly schedule to the same train job",
      "enum": ["manual", "monthly_paused"]
    },
    "model_change_mode": {
      "order": 13,
      "type": "string",
      "default": "incremental_append",
      "description": "Keep old predictions and append new rows, or rebuild all rows into a new model-version generation",
      "enum": ["incremental_append", "full_rebuild"]
    },
    "model_selection_mode": {
      "order": 16,
      "type": "string",
      "default": "pinned_version",
      "description": "Pin one model version manually or select champion after a gated training run",
      "enum": ["pinned_version", "auto_champion"]
    },
    "metric": {
      "order": 17,
      "type": "string",
      "default": "heldout_rmse",
      "description": "Heldout metric for candidate/champion comparison; must match the model task",
      "enum": ["heldout_mae", "heldout_mse", "heldout_rmse", "heldout_r2", "heldout_mape", "heldout_explained_variance", "heldout_accuracy", "heldout_balanced_accuracy", "heldout_precision_weighted", "heldout_recall_weighted", "heldout_f1_weighted", "heldout_matthews_corrcoef", "heldout_precision", "heldout_recall", "heldout_f1", "heldout_g_score", "heldout_log_loss", "heldout_roc_auc", "heldout_pr_auc", "heldout_roc_auc_ovr_weighted", "heldout_roc_auc_weighted", "heldout_roc_auc_ovr", "heldout_roc_auc_ovo", "heldout_roc_auc_ovo_weighted", "heldout_pr_auc_weighted"]
    },
    "min_improvement": {
      "order": 18,
      "type": "number",
      "default": 0.0,
      "minimum": 0,
      "description": "Minimum metric improvement over champion; ties never pass",
      "skip_prompt_if": {"properties": {"model_selection_mode": {"const": "pinned_version"}}}
    },
    "quality_threshold": {
      "order": 19,
      "type": "string",
      "default": "null",
      "description": "Enter a numeric absolute heldout gate for the first champion; null is rejected in automatic mode",
      "pattern": "^(null|-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?)$",
      "skip_prompt_if": {"properties": {"model_selection_mode": {"const": "pinned_version"}}}
    },
    "retraining_cron_expression": {
      "order": 14,
      "type": "string",
      "default": "0 0 3 3 * ?",
      "description": "Editable Quartz cron for the paused training job; use one run per month",
      "pattern": "^[A-Za-z0-9*?/,# +\\-]+$",
      "skip_prompt_if": {"properties": {"retraining_mode": {"const": "manual"}}}
    },
    "retraining_timezone_id": {
      "order": 15,
      "type": "string",
      "default": "UTC",
      "description": "IANA timezone used by the paused training schedule; training windows remain UTC months",
      "pattern": "^[A-Za-z_]+(?:/[A-Za-z0-9_+.-]+)*$",
      "skip_prompt_if": {"properties": {"retraining_mode": {"const": "manual"}}}
    },
    "compute_mode": {
      "order": 4,
      "type": "string",
      "default": "serverless",
      "description": "Job compute mode for this project",
      "enum": ["serverless", "policy_cluster"]
    },
    "catalog": {
      "order": 5,
      "type": "string",
      "default": "workspace",
      "description": "Existing dev Unity Catalog catalog",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "schema": {
      "order": 6,
      "type": "string",
      "default": "default",
      "description": "Existing dev Unity Catalog schema",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "cluster_policy_name": {
      "order": 7,
      "type": "string",
      "default": "REPLACE_WITH_APPROVED_POLICY",
      "description": "Approved job-cluster policy name",
      "skip_prompt_if": {"properties": {"compute_mode": {"const": "serverless"}}}
    },
    "spark_version": {
      "order": 8,
      "type": "string",
      "default": "17.3.x-cpu-ml-scala2.13",
      "description": "Approved Databricks ML Runtime for the job cluster",
      "skip_prompt_if": {"properties": {"compute_mode": {"const": "serverless"}}}
    },
    "node_type_id": {
      "order": 9,
      "type": "string",
      "default": "REPLACE_WITH_NODE_TYPE",
      "description": "Approved job-cluster node type",
      "skip_prompt_if": {"properties": {"compute_mode": {"const": "serverless"}}}
    },
    "cost_tag_key": {
      "order": 10,
      "type": "string",
      "default": "CostCenter",
      "description": "Approved cluster cost tag key, for example CostCenter or PayingRegNo",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "skip_prompt_if": {"properties": {"compute_mode": {"const": "serverless"}}}
    },
    "cost_tag_value": {
      "order": 11,
      "type": "string",
      "default": "REPLACE_WITH_COST_TAG",
      "description": "Approved cluster cost tag value; for PayingRegNo, enter your paying registration number",
      "skip_prompt_if": {"properties": {"compute_mode": {"const": "serverless"}}}
    },
    "risk_category": {
      "order": 20,
      "type": "string",
      "default": "",
      "description": "Optional business risk label (e.g. Low, Medium, High); leave blank when unused. This label does not change promotion gates.",
      "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9 ._-]{0,63})?$"
    }
  }
}
