{{end}}  `{{$name}}` {{if eq $name $.timestamp}}TIMESTAMP{{else}}TYPE_FOR_{{$name}}{{end}}{{- $seen = printf "%s%s," $seen $name -}}
{{- end -}}{{- end -}}
{{- end -}}
