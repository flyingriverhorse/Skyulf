{
  "project_name": "customer_classifier",
  "engine": "polars",
  "task": "classification",
  "catalog": "workspace",
  "schema": "my_dev_schema",
  "source_table_name": "labeled_customers",
  "target_column": "churn",
  "training_version": "12",
  "split_strategy": "random",
  "stratify": "true",
  "cv_enabled": "true",
  "cv_folds": "3",
  "cv_type": "stratified_k_fold",
  "cv_shuffle": "true",
  "training_sample_rows": "1000",
  "training_sample_seed": "42",
  "score_model_selection": "champion",
  "promotion_policy": "manual_approval",
  "quality_threshold": "0.7",
  "record_key_columns": "customer_id",
  "input_columns": "income, age",
  "classification_model": "random_forest_classifier",
  "classification_metric": "heldout_f1_weighted"
}
