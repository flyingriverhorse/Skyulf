        },
        {
          "not": {
            "properties": {
              "search_strategy": {
                "const": "optuna"
              }
            }
          }
        }
      ]
    }
  },
  "search_pruning": {
    "order": 713,
    "type": "string",
    "default": "true",
    "description": "3. Validation and search | Allow Optuna pruning when model and validation settings support it",
    "enum": [
      "true",
      "false"
    ],
    "skip_prompt_if": {
      "anyOf": [
        {
          "properties": {
            "training_layout": {
              "enum": [
                "multi_target"
              ]
            }
          }
        },
        {
          "properties": {
            "search_settings": {
              "const": "default"
            }
          }
        },
        {
          "not": {
            "properties": {
              "search_strategy": {
                "const": "optuna"
              }
            }
          }
        }
