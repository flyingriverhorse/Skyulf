  "search_tune_threshold": {
    "type": "string",
    "default": "false",
    "description": "3. Cross-validation | Select a binary decision threshold from inner out-of-fold predictions. Requires probability output; final holdout stays untouched.",
    "order": 714,
    "skip_prompt_if": {
      "anyOf": [
        {
          "properties": {
            "training_layout": {
              "enum": [
                "multi_target"
              ]
            }
          }
        },
        {
          "properties": {
            "cv_enabled": {
              "const": "false"
            },
            "training_layout": {
              "const": "single_model"
            }
          }
        },
        {
          "not": {
            "properties": {
              "cv_type": {
                "const": "nested_cv"
              },
              "task": {
                "const": "classification"
              }
            }
          }
        }
      ]
    },
    "enum": [
      "false",
      "true"
    ]
  }
