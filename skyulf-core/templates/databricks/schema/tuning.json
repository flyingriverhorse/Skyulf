                "const": "optuna"
              }
            }
          }
        }
      ]
    }
  },
  "search_pruner": {
    "order": 712,
    "type": "string",
    "default": "median",
    "description": "3. Validation and search | Optuna trial pruner; Core checks whether the selected model and validation method support early stopping. none disables pruning",
    "enum": [
      "median",
      "hyperband",
      "none"
    ],
    "skip_prompt_if": {
      "anyOf": [
        {
          "properties": {
            "training_layout": {
              "enum": [
                "multi_target"
              ]
            }
          }
        },
        {
          "properties": {
            "search_settings": {
              "const": "default"
            }
