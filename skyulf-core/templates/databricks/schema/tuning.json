{
  "search_strategy": {
    "order": 697,
    "type": "string",
    "default": "random",
    "description": "3. Validation and search | Choose grid, random, halving_grid, halving_random, or optional Optuna. Core supplies a model-appropriate default search space; grid strategies evaluate its full Cartesian product",
    "enum": [
      "grid",
      "random",
      "halving_grid",
      "halving_random",
      "optuna"
    ],
    "skip_prompt_if": {
      "anyOf": [
        {
          "properties": {
            "training_layout": {
              "enum": [
                "multi_target"
              ]
            }
          }
        },
        {
          "not": {}
        }
      ]
    }
  },
  "search_settings": {
    "order": 698,
    "type": "string",
    "default": "default",
    "description": "3. Validation and search | Use Core defaults for this strategy, or customize its controls below",
    "enum": [
      "default",
      "custom"
    ],
    "skip_prompt_if": {
      "anyOf": [
        {
          "properties": {
            "training_layout": {
              "enum": [
                "multi_target"
              ]
            }
          }
        },
        {
          "not": {}
        }
      ]
    }
  },
  "search_max_candidates": {
    "order": 699,
    "type": "string",
    "default": "1000",
    "description": "3. Validation and search | Maximum full-grid combinations to admit (1-10000). Grid and halving_grid run every combination, so preflight rejects a larger space",
    "pattern": "^(?:[1-9]|[1-9][0-9]{1,3}|10000)$",
    "skip_prompt_if": {
      "anyOf": [
        {
          "properties": {
            "training_layout": {
              "enum": [
                "multi_target"
              ]
            }
          }
        },
        {
          "not": {
            "properties": {
              "search_strategy": {
                "enum": [
                  "grid",
                  "halving_grid"
                ]
              }
            }
          }
        }
      ]
    }
  },
  "search_space": {
    "order": 700,
    "type": "string",
    "default": "{}",
    "description": "3. Validation and search | Optional init-file override: JSON object mapping model parameters to finite candidate lists. {} uses the selected model's Core default search space",
    "pattern": "^\\{.*\\}$",
    "skip_prompt_if": {}
  },
  "regression_search_metric": {
    "order": 701,
    "type": "string",
    "default": "rmse",
    "description": "3. Validation and search | Objective for choosing regression parameters on training folds; separate from the heldout lifecycle metric",
    "enum": [
      "rmse",
      "mae",
      "mse",
      "r2"
    ],
    "skip_prompt_if": {
      "anyOf": [
        {
          "properties": {
            "training_layout": {
              "enum": [
                "multi_target",
                "model_competition"
              ]
            }
          }
        },
        {
          "properties": {
            "task": {
              "const": "classification"
            }
          }
        }
      ]
    }
  },
  "classification_search_metric": {
    "order": 702,
    "type": "string",
    "default": "accuracy",
    "description": "3. Validation and search | Objective for choosing classification parameters on training folds; separate from the heldout lifecycle metric",
    "enum": [
      "accuracy",
      "balanced_accuracy",
      "f1",
      "f1_weighted",
      "precision",
      "recall",
      "roc_auc"
    ],
    "skip_prompt_if": {
      "anyOf": [
        {
          "properties": {
            "training_layout": {
              "enum": [
                "multi_target",
                "model_competition"
              ]
            }
          }
        },
        {
          "properties": {
            "task": {
              "const": "regression"
            }
          }
        }
      ]
    }
  },
  "search_n_trials": {
    "order": 703,
    "type": "string",
    "default": "10",
    "description": "3. Validation and search | Trials or initial sampled candidates for random, halving_random and Optuna (1-1000)",
    "pattern": "^(?:[1-9]|[1-9][0-9]{1,2}|1000)$",
    "skip_prompt_if": {
      "anyOf": [
        {
          "properties": {
            "training_layout": {
              "enum": [
                "multi_target"
              ]
            }
          }
        },
        {
          "properties": {
            "search_strategy": {
              "enum": [
                "grid",
                "halving_grid"
              ]
            }
          }
        }
      ]
    }
  },
  "search_timeout": {
    "order": 704,
    "type": "string",
    "default": "null",
    "description": "3. Validation and search | Optional Optuna soft stop in positive seconds; null disables it. A running estimator fit is not interrupted",
    "pattern": "^(?:null|[1-9][0-9]*)$",
    "skip_prompt_if": {
      "anyOf": [
        {
          "properties": {
            "training_layout": {
              "enum": [
                "multi_target"
              ]
            }
          }
        },
        {
          "properties": {
            "search_settings": {
              "const": "default"
            }
          }
        },
        {
          "not": {
            "properties": {
              "search_strategy": {
                "const": "optuna"
              }
            }
          }
        }
      ]
    }
  },
  "search_random_state": {
    "order": 705,
    "type": "string",
    "default": "42",
    "description": "3. Validation and search | Seed for sampled parameter choices, separate from the heldout split seed and CV fold seed",
    "pattern": "^(?:0|[1-9][0-9]*)$",
    "skip_prompt_if": {
      "anyOf": [
        {
          "properties": {
            "training_layout": {
              "enum": [
                "multi_target"
              ]
            }
          }
        },
        {
          "not": {}
        }
      ]
    }
  },
  "search_factor": {
    "order": 706,
    "type": "string",
    "default": "3",
    "description": "3. Validation and search | Successive halving keeps roughly one in this many candidates per round (integer 2 or more)",
    "pattern": "^(?:[2-9]|[1-9][0-9]+)$",
    "skip_prompt_if": {
      "anyOf": [
        {
          "properties": {
            "training_layout": {
              "enum": [
                "multi_target"
              ]
            }
          }
        },
        {
          "properties": {
            "search_settings": {
              "const": "default"
            }
          }
        },
        {
          "not": {
            "properties": {
              "search_strategy": {
                "enum": [
                  "halving_grid",
                  "halving_random"
                ]
              }
            }
          }
        }
      ]
    }
  },
  "search_resource": {
    "order": 707,
    "type": "string",
    "default": "n_samples",
    "description": "3. Validation and search | Halving budget resource: training rows or estimator n_estimators. n_estimators requires explicit max_resources and a compatible model",
    "enum": [
      "n_samples",
      "n_estimators"
    ],
    "skip_prompt_if": {
      "anyOf": [
        {
          "properties": {
            "training_layout": {
              "enum": [
                "multi_target"
              ]
            }
          }
        },
        {
          "properties": {
            "search_settings": {
              "const": "default"
            }
          }
        },
        {
          "not": {
            "properties": {
              "search_strategy": {
                "enum": [
                  "halving_grid",
                  "halving_random"
                ]
              }
            }
          }
        }
      ]
    }
  },
  "search_min_resources": {
    "order": 708,
    "type": "string",
    "default": "exhaust",
    "description": "3. Validation and search | Halving starting budget: exhaust, smallest, or a positive integer",
    "pattern": "^(?:exhaust|smallest|[1-9][0-9]*)$",
    "skip_prompt_if": {
      "anyOf": [
        {
          "properties": {
            "training_layout": {
              "enum": [
                "multi_target"
              ]
            }
          }
        },
        {
          "properties": {
            "search_settings": {
              "const": "default"
            }
          }
        },
        {
          "not": {
            "properties": {
              "search_strategy": {
                "enum": [
                  "halving_grid",
                  "halving_random"
                ]
              }
            }
          }
        },
        {
          "properties": {
            "search_resource": {
              "const": "n_estimators"
            }
          }
        }
      ]
    }
  },
  "search_estimator_min_resources": {
    "order": 709,
    "type": "string",
    "default": "10",
    "description": "3. Validation and search | Starting estimator budget for n_estimators halving (integer 2 or more; must not exceed max_resources)",
    "pattern": "^(?:[2-9]|[1-9][0-9]+)$",
    "skip_prompt_if": {
      "anyOf": [
        {
          "properties": {
            "training_layout": {
              "enum": [
                "multi_target"
              ]
            }
          }
        },
        {
          "properties": {
            "search_settings": {
              "const": "default"
            }
          }
        },
        {
          "not": {
            "properties": {
              "search_strategy": {
                "enum": [
                  "halving_grid",
                  "halving_random"
                ]
              }
            }
          }
        },
        {
          "not": {
            "properties": {
              "search_resource": {
                "const": "n_estimators"
              }
            }
          }
        }
      ]
    }
  },
  "search_max_resources": {
    "order": 710,
    "type": "string",
    "default": "null",
    "description": "3. Validation and search | Maximum estimator resource count for n_estimators halving; enter a positive integer compatible with the selected model",
    "pattern": "^(?:null|[1-9][0-9]*)$",
    "skip_prompt_if": {
      "anyOf": [
        {
          "properties": {
            "training_layout": {
              "enum": [
                "multi_target"
              ]
            }
          }
        },
        {
          "properties": {
            "search_settings": {
              "const": "default"
            }
          }
        },
        {
          "not": {
            "properties": {
              "search_strategy": {
                "enum": [
                  "halving_grid",
                  "halving_random"
                ]
              }
            }
          }
        },
        {
          "not": {
            "properties": {
              "search_resource": {
                "const": "n_estimators"
              }
            }
          }
        }
      ]
    }
  },
  "search_sampler": {
    "order": 711,
    "type": "string",
    "default": "tpe",
    "description": "3. Validation and search | Optuna sampler: TPE, random or CMA-ES; CMA-ES samples categorical axes randomly",
    "enum": [
      "tpe",
      "random",
      "cmaes"
    ],
    "skip_prompt_if": {
      "anyOf": [
        {
          "properties": {
            "training_layout": {
              "enum": [
                "multi_target"
              ]
            }
          }
        },
        {
          "properties": {
            "search_settings": {
              "const": "default"
            }
          }
