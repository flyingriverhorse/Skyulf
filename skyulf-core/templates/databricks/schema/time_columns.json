{
  "event_column": {
    "order": 32,
    "type": "string",
    "default": "",
    "description": "1. Data | Column containing when each record was observed, e.g. observation_date; used to select older/newer data",
    "pattern": "^(?:[A-Za-z_][A-Za-z0-9_]*)?$",
    "skip_prompt_if": {
      "anyOf": [
        {
          "properties": {
            "training_layout": {
              "const": "multi_target"
            }
          }
        },
        {
          "properties": {
            "training_window_mode": {
              "const": "full_snapshot"
            }
          }
        },
        {
          "allOf": [
            {
              "properties": {
                "training_window_mode": {
                  "const": "auto"
                }
              }
            },
            {
              "properties": {
                "split_strategy": {
                  "const": "random"
                }
              },
              "not": {
                "anyOf": [
                  {
                    "properties": {
                      "cv_type": {
                        "const": "time_series_split"
                      }
                    }
                  },
                  {
                    "properties": {
                      "cv_type": {
                        "const": "nested_cv"
                      },
                      "cv_nested_type": {
                        "const": "time_series_split"
                      }
                    }
                  }
                ],
                "allOf": [
                  {
                    "anyOf": [
                      {
                        "properties": {
                          "cv_enabled": {
                            "const": "true"
                          }
                        }
                      },
                      {
                        "properties": {
                          "training_layout": {
                            "const": "model_competition"
                          }
                        }
                      }
                    ]
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  },
  "event_time_kind": {
