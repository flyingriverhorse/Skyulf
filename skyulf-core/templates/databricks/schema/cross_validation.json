{
  "cv_enabled": {
    "type": "string",
    "default": "false",
    "description": "1. Cross-validation | Use several training-only folds to score search candidates? No duplicate post-search CV report. With CV off, search uses a training-only validation split. Final test rows stay separate. Defaults: 5-fold K-fold, shuffle enabled, seed 42; the following questions select the fold policy before the data window. Model competition always enables the shared CV policy.",
    "enum": [
      "false",
      "true"
    ],
    "order": 13,
    "skip_prompt_if": {
      "properties": {
        "training_layout": {
          "enum": [
            "multi_target",
            "model_competition"
          ]
        }
      }
    }
  },
  "cv_folds": {
    "type": "string",
    "default": "5",
    "description": "1. Cross-validation | How many CV splits? 5 means five evaluations; more splits take longer (2-20)",
    "pattern": "^(?:[2-9]|1[0-9]|20)$",
    "skip_prompt_if": {
      "anyOf": [
        {
          "properties": {
            "training_layout": {
              "const": "multi_target"
            }
          }
        },
        {
          "properties": {
            "cv_enabled": {
              "const": "false"
            },
            "training_layout": {
              "enum": [
                "single_model",
                "multi_target"
              ]
            }
          }
        }
      ]
    },
    "order": 14
  },
  "cv_type": {
    "type": "string",
    "default": "k_fold",
    "description": "1. Cross-validation | Fold method: k_fold, stratified_k_fold, time_series_split, shuffle_split, group_k_fold, stratified_group_k_fold, or nested_cv. Nested CV repeats an independent inner search in every outer training fold, then runs a separate final search Temporal CV automatically selects a chronological final holdout; its clock/window questions follow.",
    "enum": [
      "k_fold",
      "stratified_k_fold",
      "time_series_split",
      "shuffle_split",
      "nested_cv",
      "group_k_fold",
      "stratified_group_k_fold"
    ],
    "skip_prompt_if": {
      "anyOf": [
        {
          "properties": {
            "training_layout": {
              "const": "multi_target"
            }
          }
        },
        {
          "properties": {
            "cv_enabled": {
              "const": "false"
            },
            "training_layout": {
              "enum": [
                "single_model",
                "multi_target"
              ]
            }
          }
        }
      ]
    },
    "order": 15
  },
  "cv_inner_folds": {
    "type": "string",
    "default": "",
    "description": "1. Cross-validation | Inner search folds for nested CV (2-20). Leave blank for the Core default. The strategy budget applies to every outer-fold search and the final search.",
    "pattern": "^(?:|[2-9]|1[0-9]|20)$",
    "skip_prompt_if": {
      "anyOf": [
        {
          "properties": {
            "training_layout": {
              "const": "multi_target"
            }
          }
        },
        {
          "properties": {
            "cv_enabled": {
              "const": "false"
            },
            "training_layout": {
              "enum": [
                "single_model",
                "multi_target"
              ]
            }
          }
        },
        {
          "not": {
            "properties": {
              "cv_type": {
                "const": "nested_cv"
              }
            }
          }
        }
      ]
    },
    "order": 16
  },
  "cv_nested_type": {
    "type": "string",
    "default": "auto",
    "description": "1. Cross-validation | Policy at both nested levels; auto selects stratified classification or regression K-fold. Temporal requires a temporal final holdout and event_column.",
    "order": 17,
    "skip_prompt_if": {
      "anyOf": [
        {
          "properties": {
            "training_layout": {
              "const": "multi_target"
            }
          }
        },
        {
          "properties": {
            "cv_enabled": {
              "const": "false"
            },
            "training_layout": {
              "enum": [
                "single_model",
                "multi_target"
              ]
            }
          }
        },
        {
          "not": {
            "properties": {
              "cv_type": {
                "const": "nested_cv"
              }
            }
          }
        }
      ]
    },
    "enum": [
      "auto",
      "k_fold",
      "stratified_k_fold",
      "time_series_split",
      "group_k_fold",
      "stratified_group_k_fold"
    ]
  },
  "cv_group_column": {
    "type": "string",
    "default": "",
    "description": "1. Cross-validation | Group identity column, excluded from features. Final holdout isolates whole groups; disable holdout stratify.",
    "order": 18,
    "skip_prompt_if": {
      "anyOf": [
        {
          "properties": {
            "training_layout": {
              "const": "multi_target"
            }
          }
        },
        {
          "properties": {
            "cv_enabled": {
              "const": "false"
            },
            "training_layout": {
              "enum": [
                "single_model",
                "multi_target"
              ]
            }
          }
        },
        {
          "not": {
            "anyOf": [
              {
                "properties": {
                  "cv_type": {
                    "enum": [
                      "group_k_fold",
                      "stratified_group_k_fold"
                    ]
                  }
                }
              },
              {
                "properties": {
                  "cv_type": {
                    "const": "nested_cv"
                  },
                  "cv_nested_type": {
                    "enum": [
                      "group_k_fold",
                      "stratified_group_k_fold"
                    ]
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "pattern": "^(?:|[A-Za-z_][A-Za-z0-9_]*)$"
  },
  "cv_gap": {
    "type": "string",
    "default": "0",
    "description": "1. Cross-validation | Rows excluded before each temporal validation window at both nested levels.",
    "order": 19,
    "skip_prompt_if": {
      "anyOf": [
        {
          "properties": {
            "training_layout": {
              "const": "multi_target"
            }
          }
        },
        {
          "properties": {
            "cv_enabled": {
              "const": "false"
            },
            "training_layout": {
              "enum": [
                "single_model",
                "multi_target"
              ]
            }
          }
        },
        {
          "not": {
            "anyOf": [
              {
                "properties": {
                  "cv_type": {
                    "enum": [
                      "time_series_split"
                    ]
                  }
                }
              },
              {
                "properties": {
                  "cv_type": {
                    "const": "nested_cv"
                  },
                  "cv_nested_type": {
                    "enum": [
                      "time_series_split"
                    ]
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "pattern": "^(?:0|[1-9][0-9]*)$"
  },
  "cv_test_size": {
    "type": "string",
    "default": "null",
    "description": "1. Cross-validation | Temporal validation rows per fold; null uses the Core default.",
    "order": 20,
    "skip_prompt_if": {
      "anyOf": [
        {
          "properties": {
            "training_layout": {
              "const": "multi_target"
            }
          }
        },
        {
          "properties": {
            "cv_enabled": {
              "const": "false"
            },
            "training_layout": {
              "enum": [
                "single_model",
                "multi_target"
              ]
            }
          }
        },
        {
          "not": {
            "anyOf": [
              {
                "properties": {
                  "cv_type": {
                    "enum": [
                      "time_series_split"
                    ]
                  }
                }
              },
              {
                "properties": {
                  "cv_type": {
                    "const": "nested_cv"
                  },
                  "cv_nested_type": {
                    "enum": [
                      "time_series_split"
                    ]
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "pattern": "^(?:null|[1-9][0-9]*)$"
  },
  "cv_max_train_size": {
    "type": "string",
    "default": "null",
    "description": "1. Cross-validation | Temporal training rows; null expands, an integer creates a rolling window.",
    "order": 21,
    "skip_prompt_if": {
      "anyOf": [
        {
          "properties": {
            "training_layout": {
              "const": "multi_target"
            }
          }
        },
        {
          "properties": {
            "cv_enabled": {
              "const": "false"
            },
            "training_layout": {
              "enum": [
                "single_model",
                "multi_target"
              ]
            }
          }
        },
        {
          "not": {
            "anyOf": [
              {
                "properties": {
                  "cv_type": {
                    "enum": [
                      "time_series_split"
                    ]
                  }
                }
              },
              {
                "properties": {
                  "cv_type": {
                    "const": "nested_cv"
                  },
                  "cv_nested_type": {
                    "enum": [
                      "time_series_split"
                    ]
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "pattern": "^(?:null|[1-9][0-9]*)$"
  },
  "cv_shuffle": {
    "type": "string",
    "default": "true",
    "description": "1. Cross-validation | Shuffle rows for CV? Use false for time_series_split, true for shuffle_split",
    "enum": [
      "false",
      "true"
    ],
    "skip_prompt_if": {
      "anyOf": [
        {
          "properties": {
            "training_layout": {
              "const": "multi_target"
            }
          }
        },
        {
          "anyOf": [
            {
              "properties": {
                "cv_enabled": {
                  "const": "false"
                },
                "training_layout": {
                  "enum": [
                    "single_model",
                    "multi_target"
                  ]
                }
              }
            },
            {
              "properties": {
                "cv_type": {
                  "enum": [
                    "time_series_split",
                    "shuffle_split"
                  ]
                }
              }
            }
          ]
        },
        {
          "anyOf": [
            {
              "properties": {
                "cv_type": {
                  "const": "time_series_split"
                }
              }
            },
            {
              "properties": {
                "cv_type": {
                  "const": "nested_cv"
                },
                "cv_nested_type": {
                  "const": "time_series_split"
                }
              }
            }
          ],
          "allOf": [
            {
              "anyOf": [
                {
                  "properties": {
                    "cv_enabled": {
                      "const": "true"
                    }
                  }
                },
                {
                  "properties": {
                    "training_layout": {
                      "const": "model_competition"
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "order": 22
  },
  "cv_random_state": {
    "type": "string",
    "default": "42",
    "description": "1. Cross-validation | Seed for repeatable CV splits. Keep 42 unless you want different splits",
    "pattern": "^(?:0|[1-9][0-9]*)$",
    "skip_prompt_if": {
      "anyOf": [
        {
          "properties": {
            "training_layout": {
              "const": "multi_target"
            }
          }
        },
        {
          "anyOf": [
            {
              "properties": {
                "cv_enabled": {
                  "const": "false"
                },
                "training_layout": {
                  "enum": [
                    "single_model",
                    "multi_target"
                  ]
                }
              }
            },
            {
              "properties": {
                "cv_type": {
                  "const": "time_series_split"
                }
              }
            },
            {
              "properties": {
                "cv_shuffle": {
                  "const": "false"
                }
              },
              "not": {
                "properties": {
                  "cv_type": {
                    "const": "shuffle_split"
                  }
                }
              }
            }
          ]
        },
        {
          "anyOf": [
            {
              "properties": {
                "cv_type": {
                  "const": "time_series_split"
                }
              }
            },
            {
              "properties": {
                "cv_type": {
                  "const": "nested_cv"
                },
                "cv_nested_type": {
                  "const": "time_series_split"
                }
              }
            }
          ],
          "allOf": [
            {
              "anyOf": [
                {
                  "properties": {
                    "cv_enabled": {
                      "const": "true"
                    }
                  }
                },
                {
                  "properties": {
                    "training_layout": {
                      "const": "model_competition"
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "order": 23
  }
